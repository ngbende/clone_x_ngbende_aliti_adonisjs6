<section
  id="search-section"
  class="hidden sm:flex absolute w-1/4 flex-col top-0 right-0 justify-center gap-8"
>
  <!-- Barre de recherche -->
  <div
    class="fixed top-0 right-0 z-50 w-[22.5vw] bg-black bg-opacity-100 backdrop-blur text-white flex flex-col gap-4 py-4 pr-4"
  >
    <input
      type="text"
      placeholder="Rechercher"
      class="text-white bg-[#16181c] border border-white rounded-full text-sm w-full pl-10 py-2 relative"
    />
    <img
      src="https://img.icons8.com/ios/50/FFFFFF/search--v1.png"
      alt="search"
      class="w-4 h-4 absolute top-1/2 left-3 transform -translate-y-1/2"
    />
  </div>
 <div id="case_suggestion" class="flex flex-col w-full relative h-75 border-[1px] border-gray-300 rounded-xl right-10 p-5 gap-4">
  <h3 class="font-bold text-2xl text-white">Vous pourriez aimer</h3>

 @if(!suggestions || suggestions.length === 0)

    <p class="text-gray-400 text-sm">Aucun utilisateur à suggérer</p>
  @endif

  @each(s in suggestions)
    <div class="flex flex-row text-white gap-3 justify-between items-center">
      <div class="flex flex-row gap-3 items-center">
        <img 
          src="{{ s.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
          alt="profil_sugg" 
          class="rounded-full w-11 h-11"
        />
        <div class="flex flex-col">
          <p>{{ s.nom }}</p>
          <p class="text-gray-400">@user{{ s.id }}</p>
        </div>
      </div>

   <button
  type="submit"
  data-user-id="{{ s.id }}"
  class="follow-btn text-sm px-3 py-1 rounded-full
    {{ s.isFollowing ? 'bg-gray-500 text-white' : 'bg-white text-black' }}">
  {{ s.isFollowing ? 'Suivi ✔️' : 'Suivre' }}
</button>

    </div>
  @endeach
</div>

  <div
    id="case_tendance"
    class="flex flex-col w-full relative h-100 border-[1px] border-gray-300 rounded-xl right-10 p-5 gap-4 text-white"
  >
    <h3 class="font-bold text-2xl text-white">
      Ce qui se passe
    </h3>
    <div class="">
      <div class="flex flex-row justify-between">
        <p>
          Tendances
        </p>
        <a href="#">...</a>
      </div>

      <h4>
        Nairobi
      </h4>
      <p>
        51 k publications
      </p>
    </div>

    <div>
      <div class="flex flex-row justify-between">
        <p>
          Tendances
        </p>
        <a href="#">...</a>
      </div>
      <h4>
        le m23
      </h4>
      <p>
        2 728 publications
      </p>
    </div>

    <div>
      <div class="flex flex-row justify-between">
        <p>
          Tendances
        </p>
        <a href="#">...</a>
      </div>
      <h4>
        AS Monaco
      </h4>
      <p>
        5 629 publications
      </p>
    </div>
    <a href="#" class="text-blue-600">Afficher plus</a>
  </div>
  <div
    class="w-[25%] justify-end items-center h-15 flex fixed bottom-0 right-6 border-2 rounded-t-lg shadow-[0_-4px_8px_rgba(255,255,255,0.2)]"
  >
    <a href="">      <img src="assets/Button - Écrire un nouveau Message → SVG.png" alt="new message" class="w-6 h-6 mr-6" /></a>
    <a href="">      <img src="assets/Button - Ouvrir → SVG.png" alt="ouvrir" class="w-6 h-6 mr-6" /></a>
  </div>
  <footer class="mt-auto text-sm text-gray-500 text-center space-y-1">
    <p>
      <a href="#" class="hover:underline">Conditions d’utilisation</a>|
          <a href="#" class="hover:underline">Politique de confidentialité</a>|
          <a href="#" class="hover:underline">Cookies</a>
    </p>
    <p>
      <a href="#" class="hover:underline">Accessibilité</a>|
          <a href="#" class="hover:underline">Infos sur les annonces</a>|
          <a href="#" class="hover:underline">Plus</a>
    </p>
    <p class="mt-2">
      © 2025 X Corp.
    </p>
  </footer>
</section>
<!-- Ligne entre nav et main -->
<!-- Ligne entre nav et main -->
<div class="div-bar hidden sm:block fixed left-67 top-0 w-px h-screen bg-gray-700 z-50">
</div>

<!-- Ligne entre main et search -->
<div class="div-bar hidden sm:block fixed left-[70%] top-0 w-px h-screen bg-gray-700 z-50">
</div>
