    <!-- Section droite - Desktop uniquement (XL: 1280px+) -->
    <section id="search-section" class="hidden xl:flex z-50 fixed w-80 h-screen top-0 right-0 flex-col gap-6 p-4 border-l border-gray-700 bg-black overflow-y-auto">
      <!-- Barre de recherche -->
      <div class="sticky top-0 bg-black pt-4 pb-2 z-10">
        <form action="/search" method="GET" class="relative">
          <input type="text" name="query" placeholder="Rechercher" 
                 class="text-white bg-[#16181c] border border-gray-600 rounded-full text-sm w-full pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500" 
                 value="{{ query || '' }}" />
          <button type="submit" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
            🔍
          </button>
        </form>
      </div>

      <!-- Suggestions -->
      <div id="case_suggestion" class="flex flex-col w-full border border-gray-600 rounded-xl p-4 gap-4 bg-[#16181c]">
        <h3 class="font-bold text-xl text-white">Vous pourriez aimer</h3>

        @if(!suggestions || suggestions.length === 0)
          <p class="text-gray-400 text-sm">Aucun utilisateur à suggérer</p>
        @endif

        @each(s in suggestions)
        <div class="flex flex-row text-white gap-3 justify-between items-center">
          <a href="{{ route('profile.show', { id: s.id }) }}" class="flex flex-row gap-3 items-center flex-1 min-w-0">
            <img 
              src="{{ s.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
              alt="profil_sugg" 
              class="rounded-full w-10 h-10 flex-shrink-0"
            />
            <div class="flex flex-col min-w-0">
              <p class="font-semibold text-sm truncate">{{ s.nom }}</p>
              <p class="text-gray-400 text-sm">@user{{ s.id }}</p>
              @if(s.isPrivate)
                <span class="text-yellow-400 text-xs">Compte privé 🔒</span>
              @endif
            </div>
          </a>

          <button
            type="button"
            data-user-id="{{ s.id }}"
            class="follow-btn text-sm px-3 py-1 rounded-full font-semibold flex-shrink-0
              {{ s.followStatus === 'followed' ? 'bg-gray-500 text-white' : s.followStatus === 'pending' ? 'bg-yellow-500 text-black' : 'bg-white text-black' }}">
            {{ s.followStatus === 'followed' ? 'Suivi ✔️' : s.followStatus === 'pending' ? 'En attente ⏳' : 'Suivre' }}
          </button>
        </div>
        @endeach
      </div>

      <!-- Tendances -->
      <div id="case_tendance" class="flex flex-col w-full border border-gray-600 rounded-xl p-4 gap-4 text-white bg-[#16181c]">
        <h3 class="font-bold text-xl text-white">Ce qui se passe</h3>
        
        <div class="hover:bg-gray-800 p-2 rounded-lg cursor-pointer transition">
          <div class="flex flex-row justify-between">
            <p class="text-gray-400 text-sm">Tendances</p>
            <a href="#" class="text-gray-400">⋯</a>
          </div>
          <h4 class="font-bold text-white text-sm">Nairobi</h4>
          <p class="text-gray-400 text-sm">51 k publications</p>
        </div>

        <div class="hover:bg-gray-800 p-2 rounded-lg cursor-pointer transition">
          <div class="flex flex-row justify-between">
            <p class="text-gray-400 text-sm">Tendances</p>
            <a href="#" class="text-gray-400">⋯</a>
          </div>
          <h4 class="font-bold text-white text-sm">le m23</h4>
          <p class="text-gray-400 text-sm">2 728 publications</p>
        </div>

        <div class="hover:bg-gray-800 p-2 rounded-lg cursor-pointer transition">
          <div class="flex flex-row justify-between">
            <p class="text-gray-400 text-sm">Tendances</p>
            <a href="#" class="text-gray-400">⋯</a>
          </div>
          <h4 class="font-bold text-white text-sm">AS Monaco</h4>
          <p class="text-gray-400 text-sm">5 629 publications</p>
        </div>
        
        <a href="#" class="text-blue-500 text-sm hover:underline">Afficher plus</a>
      </div>

      <!-- Footer -->
      <footer class="text-xs text-gray-500 space-y-2 mt-4">
        <div class="flex flex-wrap gap-2">
          <a href="#" class="hover:underline">Conditions d'utilisation</a>·
          <a href="#" class="hover:underline">Politique de confidentialité</a>·
          <a href="#" class="hover:underline">Cookies</a>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="#" class="hover:underline">Accessibilité</a>·
          <a href="#" class="hover:underline">Infos sur les annonces</a>·
          <a href="#" class="hover:underline">Plus</a>
        </div>
        <p class="mt-2">© 2025 X Corp.</p>
      </footer>
    </section>