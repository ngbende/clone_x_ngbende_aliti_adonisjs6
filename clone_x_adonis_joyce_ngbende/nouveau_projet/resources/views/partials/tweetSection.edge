<div class="flex flex-col gap-4  m-4">
  <img
    src="{{ tweet.user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}"
    alt="avatar"
    class="profile-picture w-10 h-10 rounded-full"
  />

  <div class="text-white">
    <span class="font-bold">{{ tweet.user.nom }}</span>

    {{-- Affichage si c'est une réponse --}}
    @if(tweet.parentId)
      <p class="text-gray-400 text-xs mb-1">
        Répond à 
        <a href="{{ route('tweet.show', { id: tweet.parentId }) }}" class="text-blue-400">
          {{ tweet.user.nom }}
        </a>
      </p>
    @endif

    {{-- Affichage si c'est un retweet --}}
@if(tweet.$extras?.isRetweet)
  <p class="text-gray-400 text-xs mb-1 ml-12">
    🔁 Retweeté par {{ tweet.$extras.retweetedBy }}
  </p>
@endif

    {{-- Contenu du tweet --}}
   <p class="mt-1 leading-relaxed" x-html="tweet.contentClean">
  {{{ tweet.contentClean }}}
</p>


    
    {{-- Médias --}}
  @if(tweet.medias && tweet.medias.length > 0)
  @each(media in tweet.medias)

    {{-- Affichage des images --}}
    @if(media.type === 'image')
      <img src="/{{ media.url }}"
           alt="Tweet Image"
           class="mt-2 rounded-lg w-full max-w-md object-cover" />
    @endif

    {{-- Affichage des vidéos --}}
   @if(media.type === 'video')
  <video controls class="mt-2 rounded-lg w-full max-w-md">
    <source src="/{{ media.url }}" type="video/mp4" />
    Ton navigateur ne supporte pas la vidéo.
  </video>
@endif


  @endeach
@endif






  </div>

  <div class="flex flex-wrap justify-start items-center text-gray-400 mt-3 gap-2 text-sm">
    {{-- Répondre --}}
    <button class="openReplyForm px-2 py-0.5 rounded flex items-center gap-1"
            data-id="{{ tweet.id }}"
            data-user="{{ tweet.user.nom }}"
            data-content="{{ tweet.content }}">
      Répondre
    </button>

    {{-- Nombre de réponses --}}
    <button class="lengthReply flex items-center gap-1 px-2 py-0.5 rounded">
      <i data-lucide="message-circle" class="w-4 h-4"></i>
      {{ tweets.replies?.length || 0 }}
    </button>

    {{-- Retweet --}}
    <button class="retweet-btn flex items-center gap-1 px-2 py-0.5 rounded"
            data-tweet-id="{{ tweet.id }}">
      <i data-lucide="repeat-2" class="w-4 h-4"></i>
      <span class="retweet-count">{{ tweet.retweets?.length || 0 }}</span>
    </button>

    {{-- Like --}}
    <button class="like-btn flex items-center gap-1 px-2 py-0.5 rounded"
            data-tweet-id="{{ tweet.id }}">
      <i data-lucide="heart" class="w-4 h-4"></i>
      <span class="like-count">{{ tweet.likes?.length || 0 }}</span>
    </button>

    {{-- Partager --}}
    <button title="Partager" class="px-2 py-0.5 rounded hover:text-blue-300">📤</button>

    {{-- Supprimer si c'est mon tweet --}}
    @if(auth.user.id === tweet.user.id)
      <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
              class="px-2 py-0.5 rounded hover:text-red-400">
        Supprimer
      </button>
    @endif

    {{-- Voir le thread --}}
    <a href="{{ route('tweet.show', { id: tweet.id }) }}" class="px-2 py-0.5 rounded hover:underline">
      Voir le thread →
    </a>

    {{-- Bloquer/Débloquer si ce n'est pas mon tweet --}}
    @if(auth.user.id !== tweet.user.id)
      <form action="{{ route('user.block', { id: tweet.user.id }) }}" method="POST" class="inline-block">
        {{ csrfField() }}
        <button type="submit"
                class="px-2 py-0.5 text-xs rounded font-semibold
                       {{ isBlocked ? 'bg-green-600' : 'bg-red-600' }}">
          {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
        </button>
      </form>
    @endif
  </div>
</div>



