    </a>

    <a href="" class=" link-nav flex flex-row items-center gap-4">
      <img width="27" height="27" src="https://img.icons8.com/ios-filled/50/FFFFFF/grok.png" alt="grok" />
      <p class="text-white text-sm w-[300px]">
        Grok
      </p>
    </a>

    <a href="" class=" link-nav flex flex-row items-center gap-4">
      <img
        width="27"
        height="27"
        src="https://img.icons8.com/ios-glyphs/60/FFFFFF/group-foreground-selected.png"
