      </button></a>

    <div class="user_div flex flex-row mt-6 cursor-pointer">

      <div class="rounded-full border-black border-5 w-10 h-10 bg-[#333639] ">
        <img src="" alt="photo de profil" class="profile-picture w-full h-full object-cover  rounded-full  " />
      </div>

      <div id="para-name-user" class="flex flex-col" onclick="openLogoutModal()">
        @if(auth.user)
        <p id="username" class="text-white text-sm w-[300px] username1">
      {{ auth.user.nom }}
        </p>
        <p class="text-white text-sm w-[300px] username2">
      {{ auth.user.email }}
        </p>
        @endif
