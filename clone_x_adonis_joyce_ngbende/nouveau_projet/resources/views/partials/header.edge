<!-- LIGNE 1 - Modifier POUR TABLETTE/MOBILE SEULEMENT -->
<header class="w-1/4 sm:w-20 lg:w-1/4 h-full p-6 sm:p-4 lg:p-6 fixed left-0 top-0 z-50">
  
  <!-- LIGNE 3 - Logo responsive POUR TABLETTE/MOBILE -->
  <div class="w-full h-16 -mt-4 sm:-mt-2 lg:-mt-4 flex justify-center sm:justify-center lg:justify-start">
    <img src="assets/logo_twitter.jpg" alt="Logo Twitter" class="logo_X w-20 h-11 sm:w-12 sm:h-14 lg:w-20 lg:h-11 object-contain" />
  </div>
  
  <!-- LIGNE 5 - Navigation responsive POUR TABLETTE/MOBILE -->
  <nav class="nav-bar flex flex-col gap-5 sm:gap-4 lg:gap-5 items-start sm:items-center lg:items-start w-full ml-6 sm:ml-0 lg:ml-6">
    
    <!-- LIGNE 6 - Premier lien -->
    <a href="/home" class="link-nav flex flex-row items-center gap-4 sm:gap-2 lg:gap-4 justify-start sm:justify-center lg:justify-start w-full">
      <img width="23" height="23" src="https://img.icons8.com/ios-filled/50/FFFFFF/home.png" alt="home" />
      <!-- TEXTE CACHÉ sur tablette/mobile -->
      <p class="text-white text-sm w-auto sm:w-[300px] hidden sm:hidden lg:block">
        Domicile
      </p>
    </a>
    
    <!-- LIGNE 11 - Deuxième lien -->
    <a href="{{ route('search') }}" class="link-nav flex flex-row items-center gap-4 sm:gap-2 lg:gap-4 justify-start sm:justify-center lg:justify-start w-full">
      <img width="27" height="27" src="https://img.icons8.com/ios/50/FFFFFF/search--v1.png" alt="search--v1" />
      <!-- TEXTE CACHÉ sur tablette/mobile -->
      <p class="text-white text-sm w-auto sm:w-[300px] hidden sm:hidden lg:block">
        Explorer
      </p>
    </a>
    
    <!-- Répète le même pattern pour tous les liens... -->
    
    <!-- LIGNE 73 - Bouton Poster POUR TABLETTE/MOBILE -->
    <a href="" class="link-nav items-center flex justify-start sm:justify-center lg:justify-start w-full">
      <button>
        <!-- BOUTON RESPONSIVE -->
        <p class="text-black bg-white border-white border-[2px] rounded-full text-xl sm:text-sm lg:text-xl p-3 sm:p-2 lg:p-3 w-[200px] sm:w-10 sm:h-10 lg:w-[200px] flex items-center justify-center">
          <span class="sm:block lg:hidden">+</span>
          <span class="hidden sm:hidden lg:block">Poster</span>
        </p>
      </button>
    </a>
    
    <!-- LIGNE 78 - Section utilisateur POUR TABLETTE/MOBILE -->
    <div class="user_div flex flex-row mt-6 sm:mt-4 lg:mt-6 cursor-pointer items-start sm:items-center lg:items-start w-full">
      
      <!-- LIGNE 80 - Avatar -->
      <div class="rounded-full border-black border-5 w-10 h-10 sm:w-8 sm:h-8 lg:w-10 lg:h-10 bg-[#333639]">
        @if(auth.user)
        <img src="{{auth.user.photoProfil || '/images/default-avatar.png'}}" alt="photo de profil" class="profile-picture w-full h-full object-cover rounded-full" />
        @endif
      </div>
      
      <!-- LIGNE 86 - Infos utilisateur CACHÉES sur tablette/mobile -->
      <div id="para-name-user" class="flex flex-col hidden sm:hidden lg:flex" onclick="openLogoutModal()">
        @if(auth.user)
        <p id="username" class="text-white text-sm w-[300px] username1">
          {{ auth.user.nom }}
        </p>
        <p class="text-white text-sm w-[300px] username2">
          {{ auth.user.email }}
        </p>
        @endif
      </div>
    </div>
  </nav>
</header>