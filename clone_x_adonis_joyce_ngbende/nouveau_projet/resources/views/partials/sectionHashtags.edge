<div class="max-w-2xl mx-auto mt-6 p-4 bg-gray-900 text-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-4 text-center">
    Tweets avec <span class="text-blue-400">#{{ hashtag.texteHashtag }}</span>
  </h1>

  @each(tweet in tweets)
    <div class="tweet border-b border-gray-700 p-4 mb-4 rounded-lg hover:bg-gray-800 transition">
      
      {{-- Header tweet --}}
      <div class="flex items-center gap-3 mb-2">
        <img src="{{ tweet.user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
             alt="avatar" class="w-10 h-10 rounded-full">
        <span class="font-semibold">{{ tweet.user.username }}</span>
      </div>

      {{-- Contenu tweet --}}
      <p class="mt-1 leading-relaxed">
        {{ tweet.content }}
      </p>

      {{-- Médias --}}
      @if(tweet.medias && tweet.medias.length > 0)
        <div class="medias flex flex-wrap gap-2 mt-2">
          @each(media in tweet.medias)
            @if(media.type === 'image')
              <img src="data:image/*;base64,{{ media.url }}" class="w-32 h-32 object-cover rounded" />
            @else
              <video controls class="w-48 h-32 rounded">
                <source src="data:video/*;base64,{{ media.url }}" />
              </video>
            @endif
          @endeach
        </div>
      @endif

      {{-- Hashtags --}}
      <div class="hashtags mt-2 flex flex-wrap gap-2">
        @each(tag in tweet.hashtags)
          <a href="{{ route('hashtag.show', { tag: tag.texteHashtag }) }}" 
             class="text-blue-400 hover:underline">
            #{{ tag.texteHashtag }}
          </a>
        @endeach
      </div>

      {{-- Boutons --}}
      <div class="flex flex-wrap justify-start items-center text-gray-400 mt-3 gap-2 text-sm">
        {{-- Répondre --}}
        <button class="openReplyForm px-2 py-0.5 rounded flex items-center gap-1"
                data-id="{{ tweet.id }}"
                data-user="{{ tweet.user.username }}"
                data-content="{{ tweet.content }}">
          Répondre
        </button>

        {{-- Nombre de réponses --}}
        <button class="lengthReply flex items-center gap-1 px-2 py-0.5 rounded">
          <i data-lucide="message-circle" class="w-4 h-4"></i>
          {{ tweet.replies?.length || 0 }}
        </button>

        {{-- Retweet --}}
        <button class="retweet-btn flex items-center gap-1 px-2 py-0.5 rounded"
                data-tweet-id="{{ tweet.id }}">
          <i data-lucide="repeat-2" class="w-4 h-4"></i>
          <span class="retweet-count">{{ tweet.retweets?.length || 0 }}</span>
        </button>

        {{-- Like --}}
        <button class="like-btn flex items-center gap-1 px-2 py-0.5 rounded"
                data-tweet-id="{{ tweet.id }}">
          <i data-lucide="heart" class="w-4 h-4"></i>
          <span class="like-count">{{ tweet.likes?.length || 0 }}</span>
        </button>

        {{-- Partager --}}
        <button title="Partager" class="px-2 py-0.5 rounded hover:text-blue-300">📤</button>

        {{-- Supprimer si c'est mon tweet --}}
        @if(auth.user.id === tweet.user.id)
          <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
                  class="px-2 py-0.5 rounded hover:text-red-400">
            Supprimer
          </button>
        @endif

        {{-- Voir le thread --}}
        <a href="{{ route('tweet.show', { id: tweet.id }) }}" class="px-2 py-0.5 rounded hover:underline">
          Voir le thread →
        </a>
      </div>
    </div>
  @endeach
</div>

<script>
  // Initialiser icônes Lucide
  lucide.createIcons();
</script>
