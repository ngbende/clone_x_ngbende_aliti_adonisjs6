<div class="flex flex-col gap-4 p-4 border-b border-gray-700 hover:bg-gray-900/30 transition">
  <div class="flex gap-3">
    {{-- Avatar --}}
    <img
      src="{{ tweet.user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}"
      alt="avatar"
      class="profile-picture w-10 h-10 sm:w-12 sm:h-12 rounded-full flex-shrink-0"
    />

    {{-- Contenu principal --}}
    <div class="flex-1 min-w-0 text-white">
      <span class="font-bold text-sm sm:text-base">{{ tweet.user.nom }}</span>

      {{-- Affichage si c'est une réponse --}}
      @if(tweet.parentId)
        <p class="text-gray-400 text-xs mb-1">
          Répond à 
          <a href="{{ route('tweet.show', { id: tweet.parentId }) }}" class="text-blue-400">
            {{ tweet.user.nom }}
          </a>
        </p>
      @endif

      {{-- Affichage si c'est un retweet --}}
      @if(tweet.$extras?.isRetweet)
        <p class="text-gray-400 text-xs mb-1">
          🔁 Retweeté par {{ tweet.$extras.retweetedBy }}
        </p>
      @endif

      {{-- Contenu du tweet --}}
      <p class="mt-1 text-sm sm:text-base leading-relaxed break-words" x-html="tweet.contentClean">
        {{{ tweet.contentClean }}}
      </p>

      {{-- Médias --}}
      @if(tweet.medias && tweet.medias.length > 0)
        @each(media in tweet.medias)
          {{-- Affichage des images --}}
          @if(media.type === 'image')
            <img src="/{{ media.url }}"
                 alt="Tweet Image"
                 class="mt-2 rounded-lg w-full sm:max-w-md object-cover" />
          @endif

          {{-- Affichage des vidéos --}}
          @if(media.type === 'video')
            <video controls class="mt-2 rounded-lg w-full sm:max-w-md">
              <source src="/{{ media.url }}" type="video/mp4" />
              Ton navigateur ne supporte pas la vidéo.
            </video>
          @endif
        @endeach
      @endif
    </div>
  </div>

  {{-- Actions --}}
  <div class="flex flex-wrap justify-between sm:justify-start items-center text-gray-400 gap-2 sm:gap-3 text-xs sm:text-sm ml-0 sm:ml-14">
    {{-- Répondre --}}
    <button class="openReplyForm px-2 py-1 sm:px-3 sm:py-1.5 rounded flex items-center gap-1 hover:bg-gray-800"
            data-id="{{ tweet.id }}"
            data-user="{{ tweet.user.nom }}"
            data-content="{{ tweet.content }}">
      <span class="hidden sm:inline">Répondre</span>
      <i data-lucide="message-circle" class="w-4 h-4 sm:hidden"></i>
    </button>

    {{-- Nombre de réponses --}}
    <button class="lengthReply flex items-center gap-1 px-2 py-1 sm:px-3 sm:py-1.5 rounded hover:bg-gray-800">
      <i data-lucide="message-circle" class="w-4 h-4"></i>
      {{ tweet.replies?.length || 0 }}
    </button>

    {{-- LIKE avec couleur conditionnelle --}}
    <form action="{{ route('tweets.like', { id: tweet.id }) }}" method="POST" class="inline">
      {{ csrfField() }}
      <button type="submit" 
              class="flex items-center gap-1 px-2 py-1 sm:px-3 sm:py-1.5 rounded
                     {{ tweet.likes?.some(like => like.userId === auth.user.id) 
                        ? 'text-pink-400' 
                        : 'text-gray-400 hover:text-pink-400 hover:bg-gray-800' }}">
        <i data-lucide="heart" class="w-4 h-4"></i>
        <span>{{ tweet.likes?.length || 0 }}</span>
      </button>
    </form>

    {{-- RETWEET avec couleur conditionnelle --}}
    <form action="{{ route('tweets.retweet', { id: tweet.id }) }}" method="POST" class="inline">
      {{ csrfField() }}
      <button type="submit"
              class="flex items-center gap-1 px-2 py-1 sm:px-3 sm:py-1.5 rounded
                     {{ tweet.retweets?.some(rt => rt.userId === auth.user.id) 
                        ? 'text-green-400' 
                        : 'text-gray-400 hover:text-green-400 hover:bg-gray-800' }}">
        <i data-lucide="repeat-2" class="w-4 h-4"></i>
        <span>{{ tweet.retweets?.length || 0 }}</span>
      </button>
    </form>

    {{-- Partager --}}
    <button title="Partager" class="px-2 py-1 sm:px-3 sm:py-1.5 rounded hover:text-blue-300 hover:bg-gray-800">
      📤
    </button>

    {{-- Actions supplémentaires (cachées sur mobile, visibles sur tablette+) --}}
    <div class="hidden sm:flex gap-2 items-center">
      {{-- Supprimer si c'est mon tweet --}}
      @if(auth.user.id === tweet.user.id)
        <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
                class="px-2 py-1 sm:px-3 sm:py-1.5 rounded hover:text-red-400 hover:bg-gray-800">
          Supprimer
        </button>
      @endif

      {{-- Voir le thread --}}
      <a href="{{ route('tweet.show', { id: tweet.id }) }}" class="px-2 py-1 sm:px-3 sm:py-1.5 rounded hover:underline">
        Voir le thread →
      </a>

      {{-- Bloquer/Débloquer si ce n'est pas mon tweet --}}
      @if(auth.user.id !== tweet.user.id)
        <form action="{{ route('user.block', { id: tweet.user.id }) }}" method="POST" class="inline-block">
          {{ csrfField() }}
          <button type="submit"
                  class="px-2 py-1 text-xs rounded font-semibold
                         {{ isBlocked ? 'bg-green-600' : 'bg-red-600' }}">
            {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
          </button>
        </form>
      @endif
    </div>

    {{-- Menu contextuel mobile --}}
    <button class="sm:hidden px-2 py-1 rounded hover:bg-gray-800 ml-auto" 
            onclick="toggleMobileMenu({{ tweet.id }})">
      <i data-lucide="more-horizontal" class="w-4 h-4"></i>
    </button>
  </div>
</div>
