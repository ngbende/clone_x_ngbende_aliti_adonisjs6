@each(userItem in users)
  <div class="flex items-center gap-3 p-2 border-b border-gray-700 hover:bg-gray-800 transition-colors">
    <img 
      src="{{ userItem.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
      alt="avatar" 
      class="w-10 h-10 rounded-full"
    />
    <div class="flex flex-col">
      <p class="text-white font-semibold">{{ userItem.nom }}</p>
      @if(userItem.prenom)
        <p class="text-gray-400 text-sm">{{ userItem.prenom }}</p>
      @endif
    </div>
    <div class="ml-auto">
      {{-- Ici tu peux mettre un bouton “Suivre / Ne plus suivre” si besoin --}}
    </div>
  </div>
@endeach
