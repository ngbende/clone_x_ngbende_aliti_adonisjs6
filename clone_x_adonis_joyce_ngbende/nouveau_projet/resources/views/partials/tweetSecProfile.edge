<div class="flex flex-col gap-4 p-4 border-b border-gray-700 hover:bg-gray-900/30 transition">
  <div class="flex gap-3 ml-2 sm:ml-4 md:ml-0">  <!-- CHANGÉ ml-12 → ml-2 sm:ml-4 md:ml-0 -->
    <img
      src="{{ tweet.user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}"
      alt="avatar"
      class="profile-picture w-10 h-10 rounded-full flex-shrink-0">  <!-- AJOUTÉ flex-shrink-0 -->
    />

    <div class="flex-1 min-w-0">  <!-- AJOUTÉ min-w-0 pour le truncate -->
      <div class="text-white">
        <div class="flex items-center gap-1 flex-wrap">  <!-- AJOUTÉ pour mieux gérer le nom -->
          <span class="font-bold truncate">{{ tweet.user.nom }}</span>
          <!-- Optionnel: ajouter le badge vérifié si besoin -->
        </div>

        {{-- Affichage si c'est une réponse --}}
        @if(tweet.parentId)
          <p class="text-gray-400 text-xs mb-1 mt-1 ml-0 sm:ml-4 md:ml-0">  <!-- AJUSTÉ -->
            Répond à 
            <a href="{{ route('tweet.show', { id: tweet.parentId }) }}" class="text-blue-400">
              {{ tweet.user.nom }}
            </a>
          </p>
        @endif

        {{-- Affichage si c'est un retweet --}}
        @if(tweet.$extras?.isRetweet)
          <p class="text-gray-400 text-xs mb-1 mt-1 ml-0 sm:ml-4 md:ml-0">  <!-- AJUSTÉ -->
            🔁 Retweeté par {{ tweet.$extras.retweetedBy }}
          </p>
        @endif

        {{-- Contenu du tweet --}}
        <p class="mt-2 leading-relaxed text-sm sm:text-base break-words" x-html="tweet.contentClean">  <!-- AJOUTÉ break-words -->
          {{{ tweet.contentClean }}}
        </p>

        {{-- Médias --}}
        @if(tweet.medias && tweet.medias.length > 0)
          @each(media in tweet.medias)
            {{-- Affichage des images --}}
            @if(media.type === 'image')
              <img src="/{{ media.url }}"
                  alt="Tweet Image"
                  class="mt-3 rounded-xl w-full max-w-md object-cover" />  <!-- CHANGÉ rounded-lg → rounded-xl -->
            @endif

            {{-- Affichage des vidéos --}}
            @if(media.type === 'video')
              <video controls class="mt-3 rounded-xl w-full max-w-md">  <!-- CHANGÉ rounded-lg → rounded-xl -->
                <source src="/{{ media.url }}" type="video/mp4" />
                Ton navigateur ne supporte pas la vidéo.
              </video>
            @endif
          @endeach
        @endif
      </div>

      <!-- Boutons - Amélioré pour mobile -->
      <div class="flex flex-wrap justify-between items-center text-gray-400 mt-3 gap-1 text-xs sm:gap-4 sm:text-sm sm:justify-start">  <!-- AJUSTÉ -->
        {{-- Répondre --}}
        <button class="openReplyForm px-2 py-1 rounded-full flex items-center gap-1 hover:bg-blue-400/10 hover:text-blue-400 transition flex-1 sm:flex-none justify-center"  <!-- AJUSTÉ -->
                data-id="{{ tweet.id }}"
                data-user="{{ tweet.user.nom }}"
                data-content="{{ tweet.content }}">
          <i data-lucide="message-circle" class="w-4 h-4"></i>
          <span class="hidden sm:inline">{{ tweet.replies?.length || 0 }}</span>  <!-- AJUSTÉ -->
        </button>

        {{-- Retweet --}}
        <form action="{{ route('tweets.retweet', { id: tweet.id }) }}" method="POST" class="inline flex-1 sm:flex-none">
          {{ csrfField() }}
          <button type="submit"
                  class="flex items-center gap-1 px-2 py-1 rounded-full hover:bg-green-400/10 transition w-full justify-center
                        {{ tweet.retweets?.some(rt => rt.userId === auth.user.id) 
                          ? 'text-green-400' 
                          : 'text-gray-400 hover:text-green-400' }}">
            <i data-lucide="repeat-2" class="w-4 h-4"></i>
            <span class="hidden sm:inline">{{ tweet.retweets?.length || 0 }}</span>  <!-- AJUSTÉ -->
          </button>
        </form>

        {{-- Like --}}
        <form action="{{ route('tweets.like', { id: tweet.id }) }}" method="POST" class="inline flex-1 sm:flex-none">
          {{ csrfField() }}
          <button type="submit" 
                  class="flex items-center gap-1 px-2 py-1 rounded-full hover:bg-pink-400/10 transition w-full justify-center
                        {{ tweet.likes?.some(like => like.userId === auth.user.id) 
                          ? 'text-pink-400' 
                          : 'text-gray-400 hover:text-pink-400' }}">
            <i data-lucide="heart" class="w-4 h-4"></i>
            <span class="hidden sm:inline">{{ tweet.likes?.length || 0 }}</span>  <!-- AJUSTÉ -->
          </button>
        </form>

        {{-- Partager --}}
        <button class="px-2 py-1 rounded-full hover:bg-blue-400/10 transition flex-1 sm:flex-none justify-center">  <!-- AJOUTÉ -->
          <i data-lucide="share" class="w-4 h-4"></i>
        </button>

        {{-- Actions supplémentaires pour mobile --}}
        <div class="sm:hidden flex-1">  <!-- AJOUTÉ pour mobile -->
          {{-- Supprimer si c'est mon tweet --}}
          @if(auth.user.id === tweet.user.id)
            <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
                    class="px-2 py-1 rounded-full hover:bg-red-400/10 hover:text-red-400 transition w-full">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          @endif
        </div>
      </div>

      <!-- Actions desktop (cachées sur mobile) -->
      <div class="hidden sm:flex flex-wrap justify-start items-center text-gray-400 mt-2 gap-2 text-sm">  <!-- AJUSTÉ -->
        {{-- Voir le thread --}}
        <a href="{{ route('tweet.show', { id: tweet.id }) }}" class="px-2 py-1 rounded hover:bg-gray-400/10 hover:underline transition">
          Voir le thread →
        </a>

        {{-- Supprimer si c'est mon tweet --}}
        @if(auth.user.id === tweet.user.id)
          <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
                  class="px-2 py-1 rounded hover:bg-red-400/10 hover:text-red-400 transition">
            Supprimer
          </button>
        @endif

        {{-- Bloquer/Débloquer si ce n'est pas mon tweet --}}
        @if(auth.user.id !== tweet.user.id)
          <form action="{{ route('user.block', { id: tweet.user.id }) }}" method="POST" class="inline-block">
            {{ csrfField() }}
            <button type="submit"
                    class="px-3 py-1 text-xs rounded-full font-semibold hover:opacity-90 transition
                          {{ isBlocked ? 'bg-green-600' : 'bg-red-600' }}">
              {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
            </button>
          </form>
        @endif
      </div>
    </div>
  </div>
</div>