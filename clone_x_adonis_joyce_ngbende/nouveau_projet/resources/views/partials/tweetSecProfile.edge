<div class="flex flex-col gap-4 p-4 border-b border-gray-700 hover:bg-gray-900/30 transition">
  <div class="flex gap-3">
    <img
      src="{{ tweet.user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}"
      alt="avatar"
      class="profile-picture w-10 h-10 rounded-full flex-shrink-0">
    />

    <div class="flex-1 min-w-0">
      <div class="text-white">
        <span class="font-bold">{{ tweet.user.nom }}</span>

        @if(tweet.parentId)
          <p class="text-gray-400 text-xs mb-1">
            Répond à 
            <a href="{{ route('tweet.show', { id: tweet.parentId }) }}" class="text-blue-400">
              {{ tweet.user.nom }}
            </a>
          </p>
        @endif

        @if(tweet.$extras?.isRetweet)
          <p class="text-gray-400 text-xs mb-1">
            🔁 Retweeté par {{ tweet.$extras.retweetedBy }}
          </p>
        @endif

        <p class="mt-1 leading-relaxed break-words" x-html="tweet.contentClean">
          {{{ tweet.contentClean }}}
        </p>

        @if(tweet.medias && tweet.medias.length > 0)
          @each(media in tweet.medias)
            @if(media.type === 'image')
              <img src="/{{ media.url }}"
                  alt="Tweet Image"
                  class="mt-2 rounded-lg w-full object-cover" />
            @endif

            @if(media.type === 'video')
              <video controls class="mt-2 rounded-lg w-full">
                <source src="/{{ media.url }}" type="video/mp4" />
                Ton navigateur ne supporte pas la vidéo.
              </video>
            @endif
          @endeach
        @endif
      </div>

      <div class="flex flex-wrap justify-start items-center text-gray-400 mt-3 gap-1 text-xs md:gap-2 md:text-sm">
        <button class="openReplyForm px-2 py-1 rounded flex items-center gap-1 hover:bg-blue-400/10 hover:text-blue-400 transition"
                data-id="{{ tweet.id }}"
                data-user="{{ tweet.user.nom }}"
                data-content="{{ tweet.content }}">
          Répondre
        </button>

        <button class="lengthReply flex items-center gap-1 px-2 py-1 rounded hover:bg-gray-400/10 transition">
          <i data-lucide="message-circle" class="w-3 h-3 md:w-4 md:h-4"></i>
          {{ tweet.replies?.length || 0 }}
        </button>

        <form action="{{ route('tweets.retweet', { id: tweet.id }) }}" method="POST" class="inline">
          {{ csrfField() }}
          <button type="submit"
                  class="flex items-center gap-1 px-2 py-1 rounded hover:bg-green-400/10 transition
                        {{ tweet.retweets?.some(rt => rt.userId === auth.user.id) 
                          ? 'text-green-400' 
                          : 'text-gray-400 hover:text-green-400' }}">
            <i data-lucide="repeat-2" class="w-3 h-3 md:w-4 md:h-4"></i>
            <span>{{ tweet.retweets?.length || 0 }}</span>
          </button>
        </form>

        <form action="{{ route('tweets.like', { id: tweet.id }) }}" method="POST" class="inline">
          {{ csrfField() }}
          <button type="submit" 
                  class="flex items-center gap-1 px-2 py-1 rounded hover:bg-pink-400/10 transition
                        {{ tweet.likes?.some(like => like.userId === auth.user.id) 
                          ? 'text-pink-400' 
                          : 'text-gray-400 hover:text-pink-400' }}">
            <i data-lucide="heart" class="w-3 h-3 md:w-4 md:h-4"></i>
            <span>{{ tweet.likes?.length || 0 }}</span>
          </button>
        </form>

        @if(auth.user.id === tweet.user.id)
          <button onclick="openDeleteModal({{ tweet.id }}, '{{ tweet.content }}')"
                  class="px-2 py-1 rounded hover:bg-red-400/10 hover:text-red-400 transition">
            Supprimer
          </button>
        @endif

        <a href="{{ route('tweet.show', { id: tweet.id }) }}" class="px-2 py-1 rounded hover:bg-gray-400/10 hover:underline transition whitespace-nowrap">
          Voir le thread →
        </a>

        @if(auth.user.id !== tweet.user.id)
          <form action="{{ route('user.block', { id: tweet.user.id }) }}" method="POST" class="inline-block">
            {{ csrfField() }}
            <button type="submit"
                    class="px-2 py-1 text-xs rounded font-semibold hover:opacity-90 transition whitespace-nowrap
                          {{ isBlocked ? 'bg-green-600' : 'bg-red-600' }}">
              {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
            </button>
          </form>
        @endif
      </div>
    </div>
  </div>
</div>
