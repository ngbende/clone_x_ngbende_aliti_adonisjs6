@layout.app({ title: "Welcome page title" })
  @slot('meta')
    <meta name="description" content="A welcome page made with EdgeJS" />
  @endslot
  
  @slot('main')
    <main class="flex flex-col min-h-screen w-full">
      <!-- Container principal -->
      <div class="flex flex-col lg:flex-row flex-grow w-full max-w-7xl mx-auto">
        
        <!-- Logo - Mobile: caché, Tablette/Desktop: visible -->
        <div class="hidden lg:flex lg:w-1/2 xl:w-[55%] items-center justify-center p-8">
          <img
            src="index/assets/logo_twitter.jpg"
            alt="logo_twitter"
            class="w-full max-w-md xl:max-w-lg h-auto object-contain"
          />
        </div>

        <!-- Formulaire -->
        <div class="flex items-center justify-center w-full lg:w-1/2 xl:w-[45%] p-6 md:p-8 lg:p-12">
          <form action="" class="w-full max-w-md space-y-5">
            
            <!-- Logo mobile uniquement -->
            <div class="lg:hidden mb-6">
              <img
                src="index/assets/logo_twitter.jpg"
                alt="logo_twitter"
                class="w-10 h-10 object-contain"
              />
            </div>

            <h1 class="font-bold text-3xl md:text-4xl lg:text-5xl xl:text-6xl text-white mb-6 lg:mb-8">
              Ça se passe maintenant
            </h1>
            
            <p class="text-white text-xl md:text-2xl lg:text-3xl mb-6 lg:mb-8">
              Inscrivez‑vous.
            </p>

            <button class="bg-white flex justify-center items-center gap-2 border border-gray-300 p-2.5 md:p-3 rounded-full text-sm md:text-base font-medium text-black w-full hover:bg-gray-50 transition-colors">
              <img src="index/assets/SVG.png" alt="Google" class="w-5 h-5" />
              S'inscrire avec Google
            </button>

            <button class="bg-white flex justify-center items-center gap-2 border border-gray-300 p-2.5 md:p-3 rounded-full text-sm md:text-base font-medium text-black w-full hover:bg-gray-50 transition-colors">
              <img src="index/assets/SVG (1).png" alt="Apple" class="w-5 h-5" />
              S'inscrire avec Apple
            </button>

            <div class="flex items-center gap-4 my-4 lg:my-6">
              <div class="flex-1 h-px bg-gray-700"></div>
              <p class="text-white text-sm">OU</p>
              <div class="flex-1 h-px bg-gray-700"></div>
            </div>

            <a
              href="{{ route('show.signUp') }}"
              id="btn-creer-compte"
              class="bg-[#1D9BF0] border border-[#1D9BF0] p-2.5 md:p-3 rounded-full text-sm md:text-base font-bold text-white block text-center w-full hover:bg-[#1A8CD8] transition-colors"
            >
              Créer un compte
            </a>

            <p class="text-gray-400 text-xs md:text-sm leading-relaxed">
              En vous inscrivant, vous acceptez les
              <a href="#" class="text-[#1D9BF0] hover:underline">Conditions d'utilisation</a> et la
              <a href="#" class="text-[#1D9BF0] hover:underline">Politique de confidentialité</a>,
              notamment
              <a href="#" class="text-[#1D9BF0] hover:underline">l'Utilisation des cookies</a>.
            </p>

            <div class="pt-8 lg:pt-11 space-y-4">
              <p class="text-white text-base md:text-lg font-bold">
                Vous avez déjà un compte ?
              </p>
              <a
                href="{{ route('show.login') }}"
                id="btn-connexion1"
                class="text-[#1D9BF0] bg-transparent border border-gray-600 p-2.5 md:p-3 rounded-full text-sm md:text-base font-bold block w-full text-center hover:bg-[#031018] transition-colors"
              >
                Se connecter
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  @endslot
@end
