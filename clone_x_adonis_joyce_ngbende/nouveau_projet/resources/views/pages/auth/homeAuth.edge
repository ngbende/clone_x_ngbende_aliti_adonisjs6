@layout.app({ title: "Welcome page title" })
  @slot('meta')
    <meta name="description" content="A welcome page made with EdgeJS" />
  @endslot

  @slot('main')
    <main class="flex flex-col sm:flex-row flex-grow justify-center items-center flex-wrap mt-20 w-full max-w-6xl mx-auto gap-8">
      
        <!-- Logo - centré sur mobile, prend toute la div sur desktop -->
      <div class="w-full sm:w-1/3 h-auto flex justify-center sm:justify-start items-center sm:items-start">
        <svg class="w-16 h-16 sm:w-full sm:h-auto sm:max-w-[280px] lg:max-w-[320px] xl:max-w-[360px]" 
             viewBox="0 0 24 24" fill="white">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          />
        </svg>
      </div>


      <!-- Formulaire - 100% largeur mobile, 1/2 desktop -->
      <div class="w-full sm:w-1/2 text-center flex justify-center items-center">
        <form
          action=""
          class="w-full max-w-md flex flex-col mt-14 space-y-6 px-4"
        >
          <h1 class="font-bold text-4xl sm:text-5xl text-white mb-3 text-left">
            Ça se passe maintenant
          </h1>
          <p class="text-white text-2xl sm:text-3xl mb-6 text-left">
            Inscrivez‑vous.
          </p>

          <button
            class="bg-white flex justify-center gap-2 border-2 p-3 rounded-3xl text-sm text-black w-full hover:bg-gray-50 transition-colors"
          >
              <img
    src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
    alt="Google"
    class="w-5 h-5"
  />
            S'inscrire avec Google
          </button>

          <button
            class="bg-white flex justify-center gap-2 border-2 p-3 rounded-3xl text-sm text-black w-full hover:bg-gray-50 transition-colors"
          >
             <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 384 512"
    class="w-5 h-5 fill-black"
  >
    <path
      d="M318.7 268.6c-.3-38.2 17.1-66.9 52.3-88.3-19.7-28.2-49.4-43.7-88.6-46.8-37.3-3-78 21.7-92.9 21.7-15.2 0-50.7-20.7-78.6-20.1-40.3.6-77.7 23.5-98.4 59.6-42 73-10.7 181.2 30.2 240.3 20 29 43.8 61.5 75.2 60.3 30-1.2 41.3-19.5 77.6-19.5 36 0 46.2 19.5 78.3 18.9 32.4-.6 52.9-29.4 72.7-58.6 23-33.5 32.5-65.9 32.9-67.6-.7-.3-63-24.2-63.6-95.9zM242.7 95.5c16.5-20.2 27.6-48.4 24.6-76.5-23.8 1-52.7 15.8-69.8 36-15.3 17.7-28.7 46-25.1 73.2 26.6 2.1 54.3-13.5 70.3-32.7z"
    />
  </svg>

            S'inscrire avec Apple
          </button>

          <div class="flex items-center gap-4 my-6">
            <div class="flex-1 h-px bg-gray-600"></div>
            <p class="text-white text-sm">OU</p>
            <div class="flex-1 h-px bg-gray-600"></div>
          </div>

          <a
            href="{{ route('show.signUp') }}"
            id="btn-creer-compte"
            class="bg-[#1D9BF0] border-2 border-[#1D9BF0] p-3 rounded-3xl text-sm font-bold text-white block text-center w-full hover:bg-[#1A8CD8] transition-colors"
          >
            Créer un compte
          </a>

          <p class="text-white text-xs mt-4 text-center">
            En vous inscrivant, vous acceptez les
            <a href="#" class="text-[#1D9BF0] hover:underline">Conditions d'utilisation</a> et
            la
            <a href="#" class="text-[#1D9BF0] hover:underline">Politique de confidentialité</a>,
            notamment
            <a href="#" class="text-[#1D9BF0] hover:underline">l'Utilisation des cookies</a>.
          </p>

          <div class="mt-11">
            <p class="text-white mb-4">Vous avez déjà un compte ?</p>
            <a
              href="{{ route('show.login') }}"
              id="btn-connexion1"
              class="text-[#1D9BF0] bg-black border-2 border-gray-600 p-3 rounded-3xl text-sm font-bold block w-full text-center hover:bg-[#031018] transition-colors"
            >
              Se connecter
            </a>
          </div>
        </form>
      </div>
    </main>

    <!-- Footer -->
    <footer class="text-gray-100 text-xs w-full max-w-6xl mx-auto flex flex-wrap justify-around items-end gap-2 py-6 mt-12">
