@layout.app({ title: "Welcome page title" })
  @slot('meta')
    <meta name="description" content="A welcome page made with EdgeJS" />
  @endslot
  
  @slot('main')
    <main class="flex flex-col min-h-screen w-full bg-black">
      <!-- Container principal - PLEINE LARGEUR SUR MOBILE -->
      <div class="flex flex-col lg:flex-row flex-grow w-full max-w-7xl mx-auto">
        
        <!-- Logo - Mobile: caché, Tablette/Desktop: visible -->
        <div class="hidden lg:flex lg:w-1/2 xl:w-[55%] items-center justify-center p-8">
          <img
            src="index/assets/logo_twitter.jpg"
            alt="logo_twitter"
            class="w-full max-w-md xl:max-w-lg h-auto object-contain"
          />
        </div>

        <!-- Formulaire - PLEINE LARGEUR SUR MOBILE -->
        <div class="flex items-center justify-center w-full lg:w-1/2 xl:w-[45%] p-0 sm:p-6 md:p-8 lg:p-12">
          <div class="w-full h-full min-h-screen sm:min-h-0 sm:max-w-md sm:mx-auto sm:bg-black sm:rounded-xl sm:p-8 sm:border sm:border-gray-800 lg:border-none">
            <form action="" class="w-full h-full flex flex-col justify-center p-6 sm:p-0 sm:space-y-5">
              
              <!-- Logo mobile uniquement -->
              <div class="lg:hidden mb-8 flex justify-center">
                <img
                  src="index/assets/logo_twitter.jpg"
                  alt="logo_twitter"
                  class="w-16 h-16 sm:w-20 sm:h-20 object-contain"
                />
              </div>

              <h1 class="font-bold text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white mb-6 sm:mb-8 text-center sm:text-left">
                Ça se passe maintenant
              </h1>
              
              <p class="text-white text-2xl sm:text-2xl md:text-3xl lg:text-4xl mb-8 sm:mb-10 text-center sm:text-left">
                Inscrivez‑vous.
              </p>

              <div class="space-y-4 sm:space-y-4 mb-8 sm:mb-10">
                <button class="bg-white flex justify-center items-center gap-3 border border-gray-300 p-4 sm:p-3 rounded-full text-base sm:text-lg font-medium text-black w-full hover:bg-gray-50 transition-colors">
                  <img src="index/assets/SVG.png" alt="Google" class="w-6 h-6 sm:w-5 sm:h-5" />
                  S'inscrire avec Google
                </button>

                <button class="bg-white flex justify-center items-center gap-3 border border-gray-300 p-4 sm:p-3 rounded-full text-base sm:text-lg font-medium text-black w-full hover:bg-gray-50 transition-colors">
                  <img src="index/assets/SVG (1).png" alt="Apple" class="w-6 h-6 sm:w-5 sm:h-5" />
                  S'inscrire avec Apple
                </button>
              </div>

              <div class="flex items-center gap-4 mb-8 sm:mb-10">
                <div class="flex-1 h-px bg-gray-700"></div>
                <p class="text-white text-base sm:text-lg">OU</p>
                <div class="flex-1 h-px bg-gray-700"></div>
              </div>

              <a
                href="{{ route('show.signUp') }}"
                id="btn-creer-compte"
                class="bg-[#1D9BF0] border border-[#1D9BF0] p-4 sm:p-3 rounded-full text-lg sm:text-xl font-bold text-white block text-center w-full hover:bg-[#1A8CD8] transition-colors mb-8 sm:mb-10"
              >
                Créer un compte
              </a>

              <p class="text-gray-400 text-sm sm:text-base leading-relaxed text-center sm:text-left mb-8 sm:mb-10">
                En vous inscrivant, vous acceptez les
                <a href="#" class="text-[#1D9BF0] hover:underline">Conditions d'utilisation</a> et la
                <a href="#" class="text-[#1D9BF0] hover:underline">Politique de confidentialité</a>,
                notamment
                <a href="#" class="text-[#1D9BF0] hover:underline">l'Utilisation des cookies</a>.
              </p>

              <div class="space-y-6 sm:space-y-8 mt-auto">
                <p class="text-white text-lg sm:text-xl md:text-2xl font-bold text-center sm:text-left">
                  Vous avez déjà un compte ?
                </p>
                <a
                  href="{{ route('show.login') }}"
                  id="btn-connexion1"
                  class="text-[#1D9BF0] bg-transparent border border-gray-600 p-4 sm:p-3 rounded-full text-lg sm:text-xl font-bold block w-full text-center hover:bg-[#031018] transition-colors"
                >
                  Se connecter
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  @endslot
@end