@layout.app({ title: "Welcome page title" })
  @slot('meta')

    <meta name="description" content="A welcome page made with EdgeJS" />
  @endslot
  
  @slot('main')
    <main
      class="flex flex-grow justify-center items-center flex-wrap mt-20 w-full max-w-6xl mx-auto gap-8"
    >
      <!-- Logo - centré sur mobile, gauche sur desktop -->
      <div class="w-full sm:w-1/3 h-auto flex justify-center sm:justify-start">
        <img
          src="index/assets/logo_twitter.jpg"
          alt="logo_twitter"
          class="w-auto max-w-xs h-auto border-black bg-black object-contain"
        />
      </div>

      <!-- Formulaire - 100% largeur mobile, 1/2 desktop -->
      <div class="w-full sm:w-1/2 text-center flex justify-center items-center">
        <form action="" class="w-full max-w-md flex flex-col mt-14 space-y-6 px-4">
          <h1 class="font-bold text-4xl sm:text-5xl text-white mb-3 text-left">
            Ça se passe maintenant
          </h1>
          <p class="text-white text-2xl sm:text-3xl mb-6 text-left">
            Inscrivez‑vous.
          </p>

          <button class="bg-white flex justify-center gap-2 border-2 p-3 rounded-3xl text-sm text-black w-full">
            <img src="index/assets/SVG.png" alt="Google" />S'inscrire avec
            Google
          </button>

          <button class="bg-white flex justify-center gap-2 border-2 p-3 rounded-3xl text-sm text-black w-full">
            <img src="index/assets/SVG (1).png" alt="Apple" />S'inscrire avec
            Apple
          </button>

          <div class="flex items-center gap-4 my-6">
            <div class="flex-1 h-px bg-gray-600">
            </div>
            <p class="text-white text-sm">
              OU
            </p>
            <div class="flex-1 h-px bg-gray-600">
            </div>
          </div>

          <a
            href="{{ route('show.signUp') }}"
            id="btn-creer-compte"
            class="bg-[#1D9BF0] border-2 p-3 rounded-3xl text-sm block text-center w-full"
          >
            Créer un compte
          </a>

          <p class="text-white text-xs mt-4 text-center">
            En vous inscrivant, vous acceptez les
            <a href="#" class="text-[#1D9BF0]">Conditions d'utilisation</a>et
            la
            <a href="#" class="text-[#1D9BF0]">Politique de confidentialité</a>,
            notamment
            <a href="#" class="text-[#1D9BF0]">l'Utilisation des cookies</a>.
          </p>

          <div class="mt-11">
            <p class="text-white mb-4">
              Vous avez déjà un compte ?
            </p>
            <a
              href="{{ route('show.login') }}"
              id="btn-connexion1"
              class="text-[#1D9BF0] bg-black border-2 p-3 rounded-3xl text-sm border-white block w-full text-center"
            >
              Se connecter
            </a>
          </div>
        </form>
      </div>
    </main>
  @endslot
@end
