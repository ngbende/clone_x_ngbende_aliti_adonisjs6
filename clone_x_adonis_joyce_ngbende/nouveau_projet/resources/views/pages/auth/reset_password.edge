<!doctype html>
<html>
<head>
  <title>Nouveau mot de passe</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen flex items-center justify-center">
  <div class="max-w-md w-full bg-gray-900 p-8 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold text-white mb-6">Nouveau mot de passe</h1>
    
    @if(error)
      <div class="bg-red-500 text-white p-3 rounded mb-4">
        {{ error }}
      </div>
    @endif

    <form method="POST" action="{{ route('password.update') }}">
      {{ csrfField() }}
      <input type="hidden" name="token" value="{{ token }}">
      
      <div class="mb-4">
        <label class="block text-white mb-2">Nouveau mot de passe</label>
        <input type="password" name="password" required 
               class="w-full p-3 bg-gray-800 text-white rounded border border-gray-700">
      </div>

      <div class="mb-4">
        <label class="block text-white mb-2">Confirmer le mot de passe</label>
        <input type="password" name="password_confirmation" required 
               class="w-full p-3 bg-gray-800 text-white rounded border border-gray-700">
      </div>

      <button type="submit" 
              class="w-full bg-blue-500 text-white p-3 rounded hover:bg-blue-600">
        Réinitialiser le mot de passe
      </button>
    </form>
  </div>
</body>
</html>