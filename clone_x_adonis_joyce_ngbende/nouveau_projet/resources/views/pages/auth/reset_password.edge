<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nouveau mot de passe</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen flex items-center justify-center p-4 md:p-6 lg:p-8">
  <div class="w-full max-w-md md:max-w-lg lg:max-w-xl">
    <div class="bg-gray-900 p-6 md:p-8 lg:p-10 rounded-lg md:rounded-xl shadow-lg">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-6 md:mb-8">Nouveau mot de passe</h1>
      
      @if(flashMessages.has('errors.general'))
        <div class="bg-red-500 text-white p-3 md:p-4 rounded mb-4 md:mb-6 text-sm md:text-base">
          {{ flashMessages.get('errors.general') }}
        </div>
      @endif

      <form method="POST" action="{{ route('password.update') }}">
        {{ csrfField() }}
        <input type="hidden" name="token" value="{{ token }}">
        
        <div class="mb-4 md:mb-6">
          <label class="block text-white mb-2 md:mb-3 text-sm md:text-base">Nouveau mot de passe</label>
          <input type="password" name="password" required 
                 class="w-full p-3 md:p-4 bg-gray-800 text-white rounded md:rounded-lg border border-gray-700 focus:border-blue-500 focus:outline-none transition-colors text-sm md:text-base">
        </div>

        <div class="mb-6 md:mb-8">
          <label class="block text-white mb-2 md:mb-3 text-sm md:text-base">Confirmer le mot de passe</label>
          <input type="password" name="password_confirmation" required 
                 class="w-full p-3 md:p-4 bg-gray-800 text-white rounded md:rounded-lg border border-gray-700 focus:border-blue-500 focus:outline-none transition-colors text-sm md:text-base">
        </div>

        <button type="submit" 
                class="w-full bg-blue-500 hover:bg-blue-600 text-white p-3 md:p-4 rounded md:rounded-lg font-medium transition-colors text-sm md:text-base">
          Réinitialiser le mot de passe
        </button>
      </form>
    </div>
  </div>
</body>
</html>
