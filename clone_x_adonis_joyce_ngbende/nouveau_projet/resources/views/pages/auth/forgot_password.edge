<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mot de passe oublié</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen flex items-center justify-center p-4 sm:p-6 md:p-8">
  <div class="w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl">
    <div class="bg-gray-900 p-6 sm:p-8 md:p-10 rounded-xl border border-gray-800 sm:border-none shadow-lg">
      <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4 sm:mb-6 md:mb-8 text-center sm:text-left">Mot de passe oublié</h1>
      
      @if(flashMessages.has('errors.general'))
        <div class="bg-red-500 text-white p-3 sm:p-4 rounded-lg mb-3 sm:mb-4 md:mb-6 text-xs sm:text-sm md:text-base">
          {{ flashMessages.get('errors.general') }}
        </div>
      @endif

      @if(flashMessages.has('success'))  
        <div class="bg-green-500 text-white p-3 sm:p-4 rounded-lg mb-3 sm:mb-4 md:mb-6 text-xs sm:text-sm md:text-base">
          {{ flashMessages.get('success') }}
        </div>
      @endif

      <form method="POST" action="{{ route('password.email') }}">
        {{ csrfField() }}
        
        <div class="mb-4 sm:mb-6 md:mb-8">
          <label class="block text-white mb-2 text-sm sm:text-base">Email</label>
          <input type="email" name="email" required 
                 class="w-full p-3 sm:p-4 bg-gray-800 text-white rounded-lg border border-gray-700 focus:border-blue-500 focus:outline-none transition-colors text-sm">
        </div>

        <button type="submit" 
                class="w-full bg-blue-500 hover:bg-blue-600 text-white p-3 sm:p-4 rounded-lg font-medium transition-colors text-sm sm:text-base">
          Envoyer le lien de réinitialisation
        </button>
      </form>

      <div class="mt-4 sm:mt-6 md:mt-8 text-center">
        <a href="{{ route('show.login') }}" class="text-blue-400 hover:underline text-xs sm:text-sm md:text-base">
          Retour à la connexion
        </a>
      </div>
    </div>
  </div>
</body>
</html>