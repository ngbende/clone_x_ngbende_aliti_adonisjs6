@layout.app({ title: "Welcome page title" })
  @slot('meta')
    <meta name="description" content="A welcome page made with EdgeJS" />
  @endslot
  
  @slot('main')
    <div class="flex flex-col w-full min-h-screen">
      <!-- Header -->
      <header class="w-full border-b border-gray-700 p-4 md:p-6 lg:p-8 sticky top-0 bg-black/80 backdrop-blur">
        <div class="max-w-md mx-auto lg:max-w-2xl">
          <img src="assets/logo_twitter.jpg" alt="Logo Twitter" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
        </div>
      </header>

      <!-- Main Content -->
      <main class="flex-grow flex justify-center items-start w-full p-4 md:p-6 lg:p-8">
        <div class="w-full max-w-md">
          
          <!-- Page Title -->
          <div class="mb-8 md:mb-10">
            <h1 class="text-white text-2xl md:text-3xl lg:text-4xl font-bold leading-tight">
              Créer votre compte
            </h1>
          </div>

          <!-- Form -->
          <form id="authetification" action="{{ route('create.user') }}" method="POST" class="space-y-4 md:space-y-5">
            {{ csrfField() }}

            <!-- Error Messages -->
            @if(flashMessages.has('errors.general'))
              <div class="bg-red-500/20 border border-red-500 text-red-400 p-3 md:p-4 rounded-lg text-sm md:text-base">
                {{ flashMessages.get('errors.general') }}
              </div>
            @endif

            @if(flashMessages.has('success'))  
              <div class="bg-green-500/20 border border-green-500 text-green-400 p-3 md:p-4 rounded-lg text-sm md:text-base text-center">
                {{ flashMessages.get('success') }}
              </div>
            @endif

            <!-- Form Fields -->
            <div class="space-y-4">
              <input
                type="text"
                id="noms"
                name="nom"
                placeholder="NOM"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />

              <input
                type="text"
                id="prenom"
                name="prenom"
                placeholder="PRÉNOM"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />

              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />
              <p id="email-error" class="text-red-500 text-xs md:text-sm"></p>

              <a href="#" class="text-[#1D9BF0] hover:underline text-xs md:text-sm font-medium block">
                Utiliser un Téléphone
              </a>

              <input
                id="password"
                type="password"
                name="password"
                placeholder="Mot de passe"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />

              <input
                id="confirmPassword"
                type="password"
                name="confirmPassword"
                placeholder="Confirmez votre mot de passe"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />

              <input
                id="telephone"
                type="tel"
                name="telephone"
                placeholder="Téléphone"
                class="w-full border border-gray-600 bg-black text-white placeholder-gray-500 rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />
            </div>

            <!-- Date of Birth Section -->
            <div class="pt-4 md:pt-6">
              <h2 class="text-white font-bold text-base md:text-lg mb-2">
                Date de naissance
              </h2>
              <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-4">
                Cette information ne sera pas affichée publiquement. Confirmez votre
                âge, même si ce compte est pour une entreprise, un animal de compagnie
                ou autre chose.
              </p>

              <input
                type="date"
                name="date"
                id="due_date"
                class="w-full border border-gray-600 bg-black text-white rounded-lg px-4 md:px-5 py-2.5 md:py-3 text-sm md:text-base focus:border-[#1D9BF0] focus:outline-none transition-colors"
              />
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="btnInscription" 
              class="w-full bg-[#1D9BF0] hover:bg-[#1A8CD8] text-white font-bold rounded-full py-3 md:py-3.5 text-base md:text-lg transition-colors mt-6 md:mt-8"
            >
              Suivant
            </button>
          </form>
        </div>
      </main>
    </div>
  @endslot
@end
