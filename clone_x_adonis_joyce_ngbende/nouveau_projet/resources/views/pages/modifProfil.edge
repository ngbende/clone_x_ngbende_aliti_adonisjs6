<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modifier Profil</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white min-h-screen flex flex-col">

  {{-- Header --}}
  @include('partials/header')

  <main class="flex flex-col items-center w-full px-4 py-6">

    <h1 class="text-2xl font-bold mb-6">Modifier mon profil</h1>
    {{-- Messages de succès --}}
@if(flashMessages.has('success'))
  <div class="bg-green-500 text-white p-3 rounded mb-4">
    {{ flashMessages.get('success') }}
  </div>
@endif

{{-- Messages d'erreur généraux --}}
@if(flashMessages.has('errors.general'))
  <div class="bg-red-500 text-white p-3 rounded mb-4">
    {{ flashMessages.get('errors.general') }}
  </div>
@endif
    <form  action="{{ route('user.updateProfil') }}"
 method="POST" enctype="multipart/form-data" class="w-full max-w-2xl flex flex-col gap-4">
      {{ csrfField() }}

      {{-- Nom --}}
      <div class="flex flex-col">
        <label for="nom" class="mb-1">Nom</label>
        <input type="text" id="nom" name="nom" value="{{ user.nom }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>

      {{-- Prénom --}}
      <div class="flex flex-col">
        <label for="prenom" class="mb-1">Prénom</label>
        <input type="text" id="prenom" name="prenom" value="{{ user.prenom || '' }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>

      {{-- Email --}}
      <div class="flex flex-col">
        <label for="email" class="mb-1">Email</label>
        <input type="email" id="email" name="email" value="{{ user.email }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>

      {{-- Téléphone --}}
      <div class="flex flex-col">
        <label for="telephone" class="mb-1">Téléphone</label>
        <input type="text" id="telephone" name="telephone" value="{{ user.telephone || '' }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>

      {{-- Bio --}}
      <div class="flex flex-col">
        <label for="bio" class="mb-1">Bio</label>
        <textarea id="bio" name="bio" rows="3" 
                  class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">{{ user.bio || '' }}</textarea>
      </div>

      {{-- Location --}}
      <div class="flex flex-col">
        <label for="location" class="mb-1">Localisation</label>
        <input type="text" id="location" name="location" value="{{ user.location || '' }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>

      {{-- Website --}}
      <div class="flex flex-col">
        <label for="website" class="mb-1">Site web</label>
        <input type="url" id="website" name="website" value="{{ user.website || '' }}" 
               class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white">
      </div>
      {{-- Séparateur --}}
<div class="border-t border-gray-700 my-6 pt-6">
  <h2 class="text-xl font-bold mb-4">Changer le mot de passe</h2>
  
  {{-- Ancien mot de passe --}}
  <div class="flex flex-col mb-4">
    <label for="current_password" class="mb-1">Mot de passe actuel</label>
    <input type="password" id="current_password" name="current_password" 
           class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white"
           placeholder="Entrez votre mot de passe actuel">
  </div>

  {{-- Nouveau mot de passe --}}
  <div class="flex flex-col mb-4">
    <label for="new_password" class="mb-1">Nouveau mot de passe</label>
    <input type="password" id="new_password" name="new_password" 
           class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white"
           placeholder="Laissez vide pour ne pas changer">
  </div>

  {{-- Confirmation nouveau mot de passe --}}
  <div class="flex flex-col mb-4">
    <label for="new_password_confirmation" class="mb-1">Confirmer le nouveau mot de passe</label>
    <input type="password" id="new_password_confirmation" name="new_password_confirmation" 
           class="px-3 py-2 rounded bg-gray-800 border border-gray-600 text-white"
           placeholder="Confirmez le nouveau mot de passe">
  </div>

  <p class="text-sm text-gray-400">
    💡 Laissez les champs mot de passe vides si vous ne souhaitez pas le modifier.
  </p>
</div>

      {{-- Séparateur --}}

      {{-- Compte privé --}}
     <div class="flex items-center gap-3">
  <span>Compte privé 🔒</span>
  <label class="relative inline-flex items-center cursor-pointer">
    <input type="checkbox" name="isPrivate" value="1" class="sr-only peer" {{ user.isPrivate ? 'checked' : '' }}>
    <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:bg-blue-600 transition-colors"></div>
    <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full peer-checked:translate-x-5 transition-transform"></div>
  </label>
</div>


      {{-- Photo de profil --}}
      <div class="flex flex-col">
        <label for="photoProfil" class="mb-1">Photo de profil</label>
        <input type="file" id="photoProfil" name="photoProfil" class="text-gray-400">
        @if(user.photoProfil)
          <img src="{{ user.photoProfil }}" alt="Profil actuel" class="w-20 h-20 rounded-full mt-2">
        @endif
      </div>

      {{-- Cover Picture --}}
      <div class="flex flex-col">
        <label for="coverPicture" class="mb-1">Bannière</label>
        <input type="file" id="coverPicture" name="coverPicture" class="text-gray-400">
        @if(user.coverPicture)
          <img src="{{ user.coverPicture }}" alt="Bannière actuelle" class="w-full h-32 object-cover mt-2 rounded">
        @endif
      </div>

      {{-- Bouton --}}
      <button type="submit" class="mt-4 px-6 py-2 bg-blue-600 hover:bg-blue-700 rounded font-semibold">
        Enregistrer les modifications
      </button>
    </form>

  </main>

</body>
</html>
