<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Demandes de suivi</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white">
  @include('partials/header')

  <main class="ml-[20%] w-2/4 border-l border-r border-gray-700 min-h-screen p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold">Demandes de suivi reçues</h1>
      <a href="{{ route('home.index') }}" class="text-blue-400 hover:underline text-sm">← Retour à l’accueil</a>
    </div>

    @if(demandes.length === 0)
      <p class="text-gray-500 text-sm text-center mt-10">Aucune demande de suivi en attente.</p>
    @else
      @each(demande in demandes)
        <div class="flex items-center justify-between bg-gray-900 p-4 rounded-2xl mb-3">
          <a href="{{ route('profile.show', { id: demande.demandeur.id }) }}" 
             class="flex items-center gap-3 hover:bg-gray-800 p-2 rounded-lg transition">
            <img 
              src="{{ demande.demandeur.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
              class="w-10 h-10 rounded-full"
            >
            <span class="font-semibold hover:underline">
              {{ demande.demandeur.nom }} {{ demande.demandeur.prenom }}
            </span>
          </a>

          <div class="flex gap-2">
            @if(demande.statut === 'en_attente')
              <form action="{{ route('follow.accept', { id: demande.id }) }}" method="POST">
                {{ csrfField() }}
                <button class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-lg text-sm">
                  Accepter
                </button>
              </form>

              <form action="{{ route('follow.reject', { id: demande.id }) }}" method="POST">
                {{ csrfField() }}
                <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-sm">
                  Refuser
                </button>
              </form>
            @elseif(demande.statut === 'acceptee')
              <span class="text-green-400 text-sm">✔️ Acceptée</span>
            @elseif(demande.statut === 'refusee')
              <span class="text-gray-400 text-sm">❌ Refusée</span>
            @endif
          </div>
        </div>
      @endeach
    @endif
  </main>
</body>
</html>
