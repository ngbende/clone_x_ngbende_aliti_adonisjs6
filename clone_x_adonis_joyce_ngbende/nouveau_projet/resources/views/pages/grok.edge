<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assistant IA Grok - Générateur de tweets</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-gray-900 text-white font-sans">
 @include('partials/header')
       @!component('components/logoutModal')

    <main class="container mx-auto p-4 mt-24 lg:mt-0 lg:p-8 lg:ml-64">
        <div class="bg-gray-800 p-6 rounded-xl shadow-lg space-y-6 max-w-2xl mx-auto">

            <h1 class="text-3xl font-extrabold text-center text-blue-300">🚀 Assistant IA Grok</h1>
            <p class="text-gray-400 text-center">Génère, optimise ou analyse ton tweet grâce à l'IA !</p>

            <!-- Formulaire de base -->
           <!-- Formulaire de base -->
<form id="tweetForm" method="POST" class="space-y-4">
    {{ csrfField() }}
    <textarea
        id="tweetContent"
        name="prompt"
        placeholder="Écris ton idée de tweet ici..."
        rows="4"
        class="w-full p-3 rounded-lg bg-gray-700 border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
    ></textarea>

    <div class="flex flex-col sm:flex-row gap-4 justify-between">
        <button type="button" id="enrichBtn" class="btn-primary">
            ✨ Générer un tweet
        </button>
        <button type="button" id="hashtagBtn" class="btn-secondary">
            🏷️ Générer des hashtags
        </button>
        <button type="button" id="analyzeBtn" class="btn-tertiary">
            🔍 Analyser le tweet
        </button>
    </div>
</form>

            <!-- Résultats IA -->
            <div id="enrichedText" class="result-box hidden"></div>
            <div id="suggestions" class="result-box hidden"></div>
            <div id="analysisText" class="result-box hidden"></div>

        </div>
    </main>

    <script>
      const tweetContent = document.getElementById("tweetContent");
      const enrichedBox = document.getElementById("enrichedText");
      const suggestionsBox = document.getElementById("suggestions");
      const analysisBox = document.getElementById("analysisText");
      const csrfToken = document.querySelector('#tweetForm input[name="_csrf"]').value;

      // 1️⃣ Générer un tweet court et percutant
      document.getElementById("enrichBtn").addEventListener("click", async () => {
        enrichedBox.classList.remove("hidden");
        enrichedBox.innerText = "⏳ Génération de tweet en cours...";
        try {
          const response = await fetch("/grok/generate", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({ prompt: tweetContent.value })
          });
          if (!response.ok) throw new Error("Erreur réseau ou serveur");
          const data = await response.json();
          enrichedBox.innerText = data.content;
        } catch (err) {
          enrichedBox.innerText = "❌ Erreur lors de la génération du tweet.";
        }
      });

      // 2️⃣ Générer des hashtags pour ton tweet
      document.getElementById("hashtagBtn").addEventListener("click", async () => {
        suggestionsBox.classList.remove("hidden");
        suggestionsBox.innerText = "⏳ Génération de hashtags en cours...";
        try {
          const response = await fetch("/grok/suggest", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({ text: tweetContent.value })
          });
          if (!response.ok) throw new Error("Erreur réseau ou serveur");
          const data = await response.json();

          const hashtags = data.hashtags.split(" ");
          suggestionsBox.innerHTML =
            "✨ Hashtags suggérés : " +
            hashtags.map(tag => `<span class="text-blue-400">#${tag.replace(/^#/, "")}</span>`).join(" ");
        } catch (err) {
          suggestionsBox.innerText = "❌ Erreur lors de la génération des hashtags.";
        }
      });

      // 3️⃣ Analyser ton tweet
      document.getElementById("analyzeBtn").addEventListener("click", async () => {
        analysisBox.classList.remove("hidden");
        analysisBox.innerText = "🔍 Analyse en cours...";
        try {
          const response = await fetch("/grok/analyze", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({ text: tweetContent.value })
          });
          if (!response.ok) throw new Error("Erreur réseau ou serveur");
          const data = await response.json();

          analysisBox.innerText = data.analysis;
        } catch (err) {
          analysisBox.innerText = "❌ Erreur lors de l'analyse du tweet.";
        }
      });
    </script>

    <style>
      .btn-primary {
        @apply px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition;
      }
      .btn-secondary {
        @apply px-4 py-2 bg-purple-500 hover:bg-purple-600 text-white font-semibold rounded-lg transition;
      }
      .btn-tertiary {
        @apply px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white font-semibold rounded-lg transition;
      }
      .result-box {
        @apply bg-gray-700 p-4 rounded-lg text-sm whitespace-pre-wrap;
      }
    </style>

</body>
</html>
