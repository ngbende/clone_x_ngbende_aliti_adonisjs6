<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Espace Grok</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  </head>
  <body class="bg-black w-full flex flex-col min-h-screen">
    @include('partials/header')
    @!component('components/logoutModal')

    <main class="max-w-2xl mx-auto mt-8 text-white p-6 rounded-2xl shadow-lg">
      <h1 class="text-2xl font-bold mb-4 text-center">
        Créer un Tweet avec Grok (IA)
      </h1>

      <!-- Formulaire principal -->
      <form action="{{ route('tweet.store') }}" method="POST" enctype="multipart/form-data" id="tweetForm">
        {{ csrfField() }}

        <textarea
          required
          name="contenu"
          id="tweetContent"
          rows="4"
          placeholder="Quoi de neuf ?"
          class="w-full p-3 rounded-xl bg-gray-800 text-white border border-gray-700 focus:border-blue-500"
        ></textarea>

        <div id="enrichedText" class="mt-3 text-sm text-gray-400 hidden"></div>
        <div id="suggestions" class="mt-3 text-sm text-blue-400 hidden"></div>

        <div class="mt-4 flex justify-between items-center gap-2">
          <input type="file" name="photos" class="text-gray-300" />

          <button type="button" id="enrichBtn" class="bg-green-600 px-4 py-2 rounded-xl hover:bg-green-700">
            Enrichir
          </button>

          <button type="button" id="hashtagBtn" class="bg-blue-600 px-4 py-2 rounded-xl hover:bg-blue-700">
            Suggérer hashtags
          </button>
        </div>

        <button type="submit" class="w-full mt-4 bg-blue-500 hover:bg-blue-600 py-2 rounded-xl font-semibold">
          Publier
        </button>
      </form>
    </main>

    @include('partials/sectionFolowSearch')

    <script>
      const tweetContent = document.getElementById("tweetContent");
      const enrichedBox = document.getElementById("enrichedText");
      const suggestionsBox = document.getElementById("suggestions");
      const csrfToken = document.querySelector('#tweetForm input[name="_csrf"]').value;

      // Enrichir tweet
      document.getElementById("enrichBtn").addEventListener("click", async () => {
        enrichedBox.classList.remove("hidden");
        enrichedBox.innerText = "Traitement en cours...";
        try {
          const response = await fetch("/grok/enrich-tweet", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({ content: tweetContent.value })
          });
          if (!response.ok) throw new Error("Erreur réseau ou serveur");
          const data = await response.json();
          enrichedBox.innerText = data.enriched.message.content[0].text;
        } catch (err) {
          console.error(err);
          enrichedBox.innerText = "Erreur lors de l’enrichissement.";
        }
      });

      // Générer hashtags
      document.getElementById("hashtagBtn").addEventListener("click", async () => {
        suggestionsBox.classList.remove("hidden");
        suggestionsBox.innerText = "Génération en cours...";
        try {
          const response = await fetch("/grok/suggest-hashtags", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({ content: tweetContent.value })
          });
          if (!response.ok) throw new Error("Erreur réseau ou serveur");
          const data = await response.json();
          if (data.hashtags.message?.content?.length) {
            const text = data.hashtags.message.content[0].text;
            const hashtags = text.split("\n").map(line => line.replace(/^\d+\.\s*/, "").trim()).filter(line => line.length > 0);
            suggestionsBox.innerHTML = "Hashtags suggérés : " + hashtags.map(tag => `<span class="text-blue-400">#${tag.replace(/^#/, "")}</span>`).join(" ");
          } else {
            suggestionsBox.innerText = "Aucune suggestion trouvée.";
          }
        } catch (err) {
          console.error(err);
          suggestionsBox.innerText = "Erreur lors de la génération des hashtags.";
        }
      });
    </script>
  </body>
</html>