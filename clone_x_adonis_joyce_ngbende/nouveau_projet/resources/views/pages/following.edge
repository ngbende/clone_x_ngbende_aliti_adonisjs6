<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Accueil Twitter</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>

<body class="bg-black w-full flex flex-col min-h-screen">
  @include('partials/header')
  @!component('components/logoutModal')

  <main id="main_profil" class="flex-1 md:ml-16 lg:ml-64 pb-16 md:pb-0">
    
    <!-- Header sticky - MÊME QUE LA PREMIÈRE PAGE -->
    <div class="sticky top-0 z-40 bg-black bg-opacity-80 backdrop-blur-md border-b border-gray-700">
      <div class="flex items-center justify-around h-14 px-4">
        <a href="{{route ('home.index')}}" class="text-white font-bold text-sm border-b-2 border-blue-500 pb-3 pt-4">Pour vous</a>
        <a href="{{route ('tweets.following')}}" class="text-gray-500 font-bold text-sm hover:text-white transition pb-3 pt-4">Abonnements</a>
      </div>
    </div>

    <!-- Section création de tweet - MÊME QUE LA PREMIÈRE PAGE -->
    <section class="border-b border-gray-700">
      <div class="bg-black w-full relative flex flex-col items-start p-4">
        <div class="flex gap-3 w-full">
          <a id="username_profil" class="text-white text-sm">
            <img src="assets/sug_1.jpg" alt="photo de profil" class="profile-picture rounded-full w-10 h-10" />
          </a>
          
          <form action="{{ route('tweets.create') }}" method="POST" enctype="multipart/form-data" class="flex-1">
            {{ csrfField() }}

            <input
              id="tweets"
              type="text"
              name="inputTweet"
              placeholder="Que se passe-t-il?"
              class="border-none rounded-md text-xl text-white flex-1 bg-transparent focus:outline-none placeholder-gray-500 w-full mb-4"
            />
            
<input type="file" name="image" id="imageInput" accept="image/*" class="hidden" />
<input type="file" name="video" id="videoInput" accept="video/*" class="hidden" />

        <!-- Prévisualisations -->
      <section id="videoPreviewSection" class="video_section flex-col items-center justify-center mb-4 hidden">
  <video id="videoPreview" controls class="rounded-lg w-full max-w-md object-cover hidden"></video>
  <button type="button" onclick="removeVideo()" class="text-red-500 text-sm mt-2">Supprimer la vidéo</button>
</section>

<section id="imagePreviewSection" class="img_section flex-col items-center justify-center mb-4 hidden">
  <img id="imagePreview" class="rounded-lg w-full max-w-md object-cover hidden" />
  <button type="button" onclick="removeImage()" class="text-red-500 text-sm mt-2">Supprimer l'image</button>
</section>

        <!-- Actions - CORRIGÉ POUR MOBILE -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-t border-gray-700 pt-3 gap-3 sm:gap-0">
          <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-blue-400">
           <label for="imageInput" class="cursor-pointer text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
  <img src="https://img.icons8.com/ios-filled/50/FFFFFF/picture.png" alt="galerie" class="w-5 h-5" />
</label>
<label for="videoInput" class="cursor-pointer text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
  <img src="https://img.icons8.com/ios-filled/50/FFFFFF/video.png" alt="video" class="w-5 h-5" />
</label>
            
                
                <button class="text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
                  <img src="https://img.icons8.com/ios-filled/50/FFFFFF/grok.png" alt="grok" class="w-5 h-5" />
                </button>

                <a href="#" class="text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
                  @include('components/icones/pol')
                </a>

                <a href="#" class="text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
                  @include('components/icones/calendrier')
                </a>

                <a href="#" class="text-white p-2 rounded-full hover:bg-blue-400/10 transition flex-shrink-0">
                  @include('components/icones/localisation')
                </a>
              </div>
              
              <button type="submit" class="text-black bg-white border-white border-[2px] rounded-full text-sm font-bold px-4 py-2 hover:bg-gray-200 transition w-full sm:w-auto">
                Poster
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Feed des tweets - GARDE TES PARTIALS -->
    <section class="post_tweets flex flex-col">
      @each(tweet in tweets)
        @include('partials/tweetsFolowing')
      @endeach
    </section>
  </main>

  @include('partials/sectionFolowSearch')
  @!component('components/reponseForm')
  @!component('components/deleteTweet')

  <!-- Lignes de séparation - MÊME QUE LA PREMIÈRE PAGE -->
  <div class="hidden md:block fixed left-16 lg:left-64 top-0 w-px h-screen bg-gray-700 z-40"></div>
    <!-- Ligne entre main et search (uniquement quand search est visible) -->
    <div class="hidden xl:block fixed right-80 top-0 w-px h-screen bg-gray-700 z-40"></div>
    <script>
  // Prévisualisation image
  document.addEventListener('DOMContentLoaded', function() {
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewSection = document.getElementById('imagePreviewSection');

    imageInput.addEventListener('change', function() {
      const file = this.files[0];
      if (!file) return;

      // Masquer la prévisualisation vidéo si elle existe
      hideVideoPreview();
      
      const reader = new FileReader();
      reader.onload = function(e) {
        imagePreview.src = e.target.result;
        imagePreview.classList.remove('hidden');
        imagePreviewSection.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });

    // Prévisualisation vidéo
    const videoInput = document.getElementById('videoInput');
    const videoPreview = document.getElementById('videoPreview');
    const videoPreviewSection = document.getElementById('videoPreviewSection');

    videoInput.addEventListener('change', function() {
      const file = this.files[0];
      if (!file) return;

      // Masquer la prévisualisation image si elle existe
      hideImagePreview();
      
      const url = URL.createObjectURL(file);
      videoPreview.src = url;
      videoPreview.classList.remove('hidden');
      videoPreviewSection.classList.remove('hidden');

      videoPreview.onloadedmetadata = function() {
        console.log(`Durée vidéo: ${videoPreview.duration.toFixed(1)} secondes`);
      };
    });

    // Fonctions pour supprimer les prévisualisations
    function removeImage() {
      imageInput.value = '';
      hideImagePreview();
    }

    function removeVideo() {
      videoInput.value = '';
      hideVideoPreview();
    }

    function hideImagePreview() {
      imagePreview.classList.add('hidden');
      imagePreviewSection.classList.add('hidden');
      imagePreview.src = '';
    }

    function hideVideoPreview() {
      videoPreview.classList.add('hidden');
      videoPreviewSection.classList.add('hidden');
      videoPreview.src = '';
    }

    });
</script>

<script>
  lucide.createIcons();
</script>
<script>
document.querySelectorAll('.like-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const tweetId = btn.dataset.tweetId
    const countEl = btn.querySelector('.like-count')
    const heartEl = btn.querySelector('i')

    try {
      const res = await fetch(`/tweets/${tweetId}/like`, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-TOKEN': '{{ csrfToken }}'
        }
      })

      const data = await res.json()

      if (data.success) {
        let count = parseInt(countEl.textContent)

        if (data.action === 'liked') {
          countEl.textContent = count + 1
          heartEl.classList.remove('text-gray-400')
          heartEl.classList.add('text-pink-400')
        } else if (data.action === 'unliked') {
          countEl.textContent = Math.max(0, count - 1)
          heartEl.classList.remove('text-pink-400')
          heartEl.classList.add('text-gray-400')
        }
      }

    } catch (err) {
      console.error('Erreur like:', err)
    }
  })
})


</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.retweet-btn')
    if (!btn) return

    const tweetId = btn.dataset.tweetId
    const countEl = btn.querySelector('.retweet-count')
    const iconEl = btn.querySelector('i')

    try {
      const res = await fetch(`/tweets/${tweetId}/retweet`, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-TOKEN': '{{ csrfToken }}'
        }
      })

      const data = await res.json()
      console.log('Toggle retweet:', data)

      let count = Number(countEl.textContent)

      if (data.action === 'retweeted') {
        countEl.textContent = count + 1
        iconEl.classList.replace('text-gray-400', 'text-green-400')
      } else {
        countEl.textContent = Math.max(0, count - 1)
        iconEl.classList.replace('text-green-400', 'text-gray-400')
      }

    } catch (err) {
      console.error('Erreur retweet:', err)
    }
  })
})
</script>
{{--  script pour le bouton de suivi   --}}
<script>
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async e => {
    e.preventDefault()
    const userId = btn.dataset.userId

    try {
      const res = await fetch(`/follow/${userId}/toggle`, {
        method: 'POST',
        headers: {
          'X-CSRF-TOKEN': '{{ csrfToken }}',
          'X-Requested-With': 'XMLHttpRequest',
        }
      })

      const data = await res.json()

      if (data.status === 'followed') {
        btn.textContent = 'Suivi ✔️'
        btn.classList.add('bg-gray-200')
      } else if (data.status === 'unfollowed') {
        btn.textContent = 'Suivre'
        btn.classList.remove('bg-gray-200')
      }
    } catch (err) {
      console.error('Erreur toggle follow:', err)
    }
  })
})
</script>

  </body>
</html>
