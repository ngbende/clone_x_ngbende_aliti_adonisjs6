<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  </head>
  <body class="bg-black w-full flex flex-col h-screen">
    @include('partials/header')
    @!component('components/logoutModal')

    <main id="main_profil" class="w-full flex-1 flex flex-col md:ml-[18%] md:w-[82%] lg:w-2/4">
      {{-- Header sticky --}}
      <div class="sticky z-50 h-14 sm:h-16 top-0 bg-black bg-opacity-80 backdrop-blur-md text-white flex items-center justify-between sm:justify-around gap-4 sm:gap-10 px-4 sm:p-4 border-b border-gray-700 text-xs sm:text-sm md:text-base">
        <div class="flex flex-row items-center gap-4 sm:gap-8 md:gap-52">
          <a href="{{route ('home.index')}}" class="text-white text-xs sm:text-sm hover:text-gray-300">Pour vous</a>
          <a href="{{route ('tweets.following')}}" class="text-white text-xs sm:text-sm hover:text-gray-300">Abonnements</a>
        </div>
      </div>

      {{-- Section composer tweet --}}
      <section id="photo_profil" class="flex flex-col bg-gray-700 w-full md:h-40">
        <div class="bg-black w-full relative flex flex-col items-start">
          <div class="flex flex-row gap-2 sm:gap-3 p-3 sm:p-5 w-full">
            {{-- Avatar --}}
            <a id="username_profil" class="flex-shrink-0">
              <img src="assets/sug_1.jpg" alt="photo de profil" class="profile-picture rounded-full w-10 h-10 sm:w-12 sm:h-12" />
            </a>

            {{-- Formulaire tweet --}}
            <form action="{{ route('tweets.create') }}" method="POST" enctype="multipart/form-data" class="flex-1">
              {{ csrfField() }}

              <div class="flex flex-col gap-3 sm:gap-4 w-full">
                <input
                  id="tweets"
                  type="text"
                  name="inputTweet"
                  placeholder="Que se passe-t-il?"
                  class="border-none rounded-md text-sm sm:text-lg md:text-2xl text-white w-full bg-transparent focus:outline-none placeholder-gray-500"
                />

                <input type="file" name="image" id="imageInput" accept="image/*" style="display: none" />
                <input type="file" name="video" id="videoInput" accept="video/*" style="display: none" />

                {{-- Section prévisualisation vidéo --}}
                <section class="video_section flex-col items-center justify-center h-40 sm:h-60 md:h-80 w-full border-b border-gray-700 text-white" style="display:none">
                  <video id="videoPreview" controls class="rounded-lg w-full h-full object-cover" style="display:none"></video>
                </section>

                {{-- Section prévisualisation image --}}
                <section class="img_section flex-col items-center justify-center h-40 sm:h-60 md:h-80 w-full border-b border-gray-700 text-white" style="display: none">
                  <img id="imagePreview" style="display: none" class="rounded-lg w-full h-full object-cover" />
                </section>

                {{-- Boutons actions --}}
                <div class="flex gap-2 sm:gap-4 items-center py-2 sm:py-3 border-b border-gray-700 w-full overflow-x-auto">
                  {{-- Galerie image --}}
                  <button type="button" id="openFilePicker" class="cursor-pointer text-white flex-shrink-0 hover:text-blue-400">
                    <img src="https://img.icons8.com/ios-filled/50/FFFFFF/picture.png" alt="galerie" class="w-4 h-4 sm:w-5 sm:h-5" />
                  </button>

                  {{-- Galerie vidéo --}}
                  <button type="button" id="openVideoPicker" class="cursor-pointer text-white flex-shrink-0 hover:text-blue-400">
                    <img src="https://img.icons8.com/ios-filled/50/FFFFFF/video.png" alt="video" class="w-4 h-4 sm:w-5 sm:h-5" />
                  </button>

                  {{-- GIF --}}
                  <button type="button" class="text-white flex-shrink-0 hover:text-blue-400">
                    <img src="https://img.icons8.com/ios-filled/50/FFFFFF/grok.png" alt="grok" class="w-4 h-4 sm:w-5 sm:h-5" />
                  </button>

                  {{-- Sondage --}}
                  <a href="#" class="text-white flex-shrink-0 hover:text-blue-400">
                    @include('components/icones/pol')
                  </a>

                  {{-- Calendrier --}}
                  <a href="#" class="text-white flex-shrink-0 hover:text-blue-400">
                    @include('components/icones/calendrier')
                  </a>

                  {{-- Localisation --}}
                  <a href="#" class="text-white flex-shrink-0 hover:text-blue-400">
                    @include('components/icones/localisation')
                  </a>

                  {{-- Bouton Poster --}}
                  <button
                    type="submit"
                    class="btn_post ml-auto text-black bg-white border-white border-[2px] rounded-full text-xs sm:text-sm md:text-lg font-bold px-4 sm:px-6 py-1.5 sm:py-2 hover:bg-gray-200 transition"
                  >
                    <span class="hidden sm:inline">Poster</span>
                    <span class="sm:hidden">Post</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </section>

      {{-- Section tweets --}}
      <section class="post_tweets flex flex-col w-full border-b border-gray-700 text-white flex-1 overflow-y-auto">
        @each(tweet in tweets)
          @include('partials/tweetsFolowing')
          @!component('components/reponseForm')
          @!component('components/deleteTweet')
        @endeach
      </section>
    </main>

    {{-- Section search/follow (cachée sur mobile, visible md+) --}}
    <div class="hidden md:block">
      @include('partials/sectionFolowSearch')
    </div>
    <script>
  const fileBtn = document.getElementById('openFilePicker')
  const fileInput = document.getElementById('imageInput')
  const previewContainer = document.querySelector('.img_section')
  const preview = document.getElementById('imagePreview')

  fileBtn.addEventListener('click', () => {
    fileInput.click()
  })

  fileInput.addEventListener('change', () => {
    const file = fileInput.files[0]
    if (!file) return

    const reader = new FileReader()
    reader.onload = () => {
      preview.src = reader.result
      preview.style.display = 'block'
      previewContainer.style.display = 'flex'
    }
    reader.readAsDataURL(file)
  })

  const videoBtn = document.getElementById('openVideoPicker')
const videoInput = document.getElementById('videoInput')
const videoPreviewContainer = document.querySelector('.video_section')
const videoPreview = document.getElementById('videoPreview')

videoBtn.addEventListener('click', () => {
  videoInput.click()
})

videoInput.addEventListener('change', () => {
  const file = videoInput.files[0]
  if (!file) return

  const url = URL.createObjectURL(file)
  videoPreview.src = url
  videoPreview.style.display = 'block'
  videoPreviewContainer.style.display = 'flex'

  videoPreview.onloadedmetadata = () => {
    console.log(`Durée vidéo: ${videoPreview.duration.toFixed(1)} secondes`)
  }
})
</script>

<script>
  lucide.createIcons();
</script>
<script>
document.querySelectorAll('.like-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const tweetId = btn.dataset.tweetId
    const countEl = btn.querySelector('.like-count')
    const heartEl = btn.querySelector('i')

    try {
      const res = await fetch(`/tweets/${tweetId}/like`, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-TOKEN': '{{ csrfToken }}'
        }
      })

      const data = await res.json()

      if (data.success) {
        let count = parseInt(countEl.textContent)

        if (data.action === 'liked') {
          countEl.textContent = count + 1
          heartEl.classList.remove('text-gray-400')
          heartEl.classList.add('text-pink-400')
        } else if (data.action === 'unliked') {
          countEl.textContent = Math.max(0, count - 1)
          heartEl.classList.remove('text-pink-400')
          heartEl.classList.add('text-gray-400')
        }
      }

    } catch (err) {
      console.error('Erreur like:', err)
    }
  })
})


</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.retweet-btn')
    if (!btn) return

    const tweetId = btn.dataset.tweetId
    const countEl = btn.querySelector('.retweet-count')
    const iconEl = btn.querySelector('i')

    try {
      const res = await fetch(`/tweets/${tweetId}/retweet`, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-TOKEN': '{{ csrfToken }}'
        }
      })

      const data = await res.json()
      console.log('Toggle retweet:', data)

      let count = Number(countEl.textContent)

      if (data.action === 'retweeted') {
        countEl.textContent = count + 1
        iconEl.classList.replace('text-gray-400', 'text-green-400')
      } else {
        countEl.textContent = Math.max(0, count - 1)
        iconEl.classList.replace('text-green-400', 'text-gray-400')
      }

    } catch (err) {
      console.error('Erreur retweet:', err)
    }
  })
})
</script>
{{--  script pour le bouton de suivi   --}}
<script>
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async e => {
    e.preventDefault()
    const userId = btn.dataset.userId

    try {
      const res = await fetch(`/follow/${userId}/toggle`, {
        method: 'POST',
        headers: {
          'X-CSRF-TOKEN': '{{ csrfToken }}',
          'X-Requested-With': 'XMLHttpRequest',
        }
      })

      const data = await res.json()

      if (data.status === 'followed') {
        btn.textContent = 'Suivi ✔️'
        btn.classList.add('bg-gray-200')
      } else if (data.status === 'unfollowed') {
        btn.textContent = 'Suivre'
        btn.classList.remove('bg-gray-200')
      }
    } catch (err) {
      console.error('Erreur toggle follow:', err)
    }
  })
})
</script>

  </body>
</html>
