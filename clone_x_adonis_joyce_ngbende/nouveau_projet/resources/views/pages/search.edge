<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Recherche</title>
</head>

<body class="flex flex-col min-h-screen text-white bg-black">
 @include('partials/headerProfile')

       @!component('components/logoutModal')
<div class="flex flex-1">
  <main class="flex-1 w-full px-4 py-4 border-l border-r border-gray-700 sm:px-0 md:ml-20 md:max-w-2xl md:mx-auto lg:ml-64 lg:max-w-3xl xl:w-2/4 xl:mx-auto xl:mt-8 xl:pt-4">
    <!-- Votre contenu principal reste identique -->
    <form action="{{ route('search') }}" method="GET" class="mb-4"> 
      <input
        type="text"
        name="query"
        value="{{ query }}"
        placeholder="Recherche..."
        class="w-full p-2 text-sm rounded bg-gray-800 border border-gray-600 sm:text-base md:text-lg md:p-3 xl:w-3/4 xl:mx-auto "
      />
    </form>

    <h2 class="font-bold text-base mb-3 sm:text-lg md:text-xl xl:mt-8 xl:ml-4">Utilisateurs</h2>
    @if(users.length === 0)
      <p class="text-gray-500 text-xs sm:text-sm md:text-base xl:ml-4">Aucun utilisateur trouvé.</p>
    @endif

    @each(user in users)
    <div class="flex items-center gap-2 p-2 border-b border-gray-700 hover:bg-gray-800 transition-colors sm:gap-3 md:gap-4 md:p-3 xl:mx-auto xl:w-3/4">
      <div>
  <a href="{{ route('profile.show', { id: user.id }) }}" class="flex items-center gap-2 flex-1 sm:gap-3 md:gap-4 min-w-0">
        <img 
          src="{{ user.photoProfil || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}" 
          alt="avatar" 
          class="w-10 h-10 rounded-full flex-shrink-0 md:w-12 md:h-12"
        />
        <div class="flex flex-col min-w-0">
          <p class="text-white font-semibold text-sm truncate sm:text-base md:text-lg">{{ user.nom }} {{ user.prenom }}</p>
        </div>
      </a>
      </div>
    
  <form action="{{ route('user.follow', { id: user.id }) }}" method="POST" class="inline-block">
        {{ csrfField() }}
        <button
          type="submit"
          class="follow-btn text-sm px-3 py-1 rounded-full font-semibold flex-shrink-0
            {{ user.followStatus === 'followed' ? 'bg-gray-500 text-white' : user.followStatus === 'pending' ? 'bg-yellow-500 text-black' : 'bg-white text-black' }}">
          {{ user.followStatus === 'followed' ? 'Suivi ✔️' : user.followStatus === 'pending' ? 'En attente ⏳' : 'Suivre' }}
        </button>
      </form>
    
    </div>

    @endeach

    <h2 class="font-bold text-base mt-6 mb-3 sm:text-lg md:text-xl xl:mt-12  xl:ml-4">Tweets</h2>
    @if(tweets.length === 0)
      <p class="text-gray-500 text-xs sm:text-sm md:text-base xl:ml-4">Aucun tweet trouvé.</p>
    @endif

    @each(tweet in tweets)
      @include('partials/tweetSection')
    @endeach
  </main>

  <!-- Section droite - Desktop uniquement -->
  @include('partials/sectionFolowSearch')
</div>

</body>
</html>