<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  </head>

  <body class="bg-black w-full flex flex-col min-h-screen">

    <main id="main_profil" class="flex-1 pb-16 mt-16 border-l border-r border-gray-700 w-full md:ml-16 md:pb-0 md:mt-0 md:max-w-2xl md:mx-auto lg:ml-64">

      <!-- Header sticky -->
      <div class="sticky top-0 z-50 bg-black/70 backdrop-blur-md text-white flex items-center gap-3 p-4 border-b border-gray-700">
        <a href="/home" class="flex-shrink-0">
          <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <a href="/search" class="flex-shrink-0">
          <i data-lucide="search" class="w-4 h-4"></i>
        </a>

        <div class="flex flex-col min-w-0 flex-1">
          <p class="font-semibold text-white text-sm truncate">{{user.nom}}</p>
          <p class="text-gray-400 text-xs">{{ `${user.replies?.length || 0} messages` }}</p>
        </div>

        <div class="ml-auto flex-shrink-0">
          <i data-lucide="search" class="w-4 h-4"></i>
        </div>
      </div>

      <!-- Bannière + avatar -->
      <section id="photo_profil" class="relative w-full h-32 bg-gray-700 sm:h-40 md:h-52">
        <img src="{{ user.coverPicture || 'https://abs.twimg.com/sticky/default_profile_images/default_profile_400x400.png' }}"
             class="object-cover w-full h-full" id="banner-img" alt="Bannière"/>
        <img src="{{ user.photoProfil || '/images/default-avatar.png' }}"
             class="absolute -bottom-8 left-4 w-16 h-16 rounded-full border-2 border-black object-cover sm:-bottom-10 sm:w-20 sm:h-20 md:-bottom-14 md:w-32 md:h-32 md:border-4"
             id="profile-img" alt="Avatar"/>
      </section>

      <!-- Infos utilisateur -->
      <div id="para-name-user_profil" class="mt-10 px-4 text-white relative sm:mt-12 md:mt-16">

        <!-- Bouton Modifier le profil -->
        <div class="absolute -top-12 right-4 sm:-top-14 md:-top-16">
          <a href="/profile/edit"
             class="px-4 py-2 border border-gray-500 rounded-full text-sm bg-black/70 hover:bg-gray-700 transition inline-block">
            Modifier le profil
          </a>
        </div>

        <p class="font-semibold text-lg sm:text-xl">{{user.nom}}</p>
        <p class="text-gray-400 text-sm">@{{user.nom}}</p>

        <p class="mt-3 text-white text-sm leading-relaxed sm:text-base">{{ user.bio }}</p>

        <div class="flex flex-col gap-2 items-start mt-3 text-gray-400 text-sm sm:flex-row sm:flex-wrap sm:items-center">
          <div class="flex items-center gap-1">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            <span>{{ user.location }}</span>
          </div>

          <div class="flex items-center gap-1">
            <i data-lucide="link-2" class="w-4 h-4"></i>
            <a href="{{ user.website }}" class="text-blue-400 hover:underline truncate max-w-[200px]" target="_blank">
              {{ user.website.length > 30 ? user.website.substring(0, 30) + '...' : user.website }}
            </a>
          </div>

          <div class="flex items-center gap-1">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            <span>{{ `Inscrit en ${user.createdAt.year}` }}</span>
          </div>
        </div>

        <div class="flex gap-4 mt-3 text-sm">
          <p class="flex items-center gap-1">
            <span class="font-semibold">{{ user.following?.length || 0 }}</span>
            <a href="/profile/follows?type=followings"
               class="text-gray-400 hover:text-white">
              abonnements
            </a>
          </p>
          <p class="flex items-center gap-1">
            <span class="font-semibold">{{ user.followers?.length || 0 }}</span>
            <a href="/profile/follows?type=followers"
               class="text-gray-400 hover:text-white">
              abonnés
            </a>
          </p>
        </div>

        <!-- Bouton Bloquer -->
        <div class="mt-4">
          <form action="/user/block" method="POST" class="inline-block">
            <button type="submit"
                    class="px-4 py-2 rounded-full text-sm font-semibold bg-red-600 hover:opacity-90 transition">
              Bloquer
            </button>
          </form>
        </div>
      </div>

      <!-- Onglets profil -->
      <section id="post_profil" class="flex w-full border-b border-gray-700 mt-6">
        <nav id="nav_post" class="flex w-full text-sm overflow-x-auto">
          <a href="#" class="tab flex-1 text-center py-3 font-semibold border-b-2 border-blue-500 text-white active whitespace-nowrap px-4" data-target="posts">Posts</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="replies">Réponses</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="medias">Tweets-marquants</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="likes">J'aime</a>
        </nav>
      </section>

      <!-- Contenu des onglets -->
      <section id="profile-tweets" class="flex flex-col">
        <div id="container-posts">
          <div class="p-4 border-b border-gray-700 text-white">Premier tweet de test ! 🚀</div>
        </div>

        <div id="container-replies" class="hidden">
          <div class="p-4 border-b border-gray-700 text-white">Réponse 1</div>
        </div>

        <div id="container-medias" class="hidden">
          <div class="p-4 border-b border-gray-700 text-white">Media 1</div>
        </div>

        <div id="container-likes" class="hidden">
          <div class="p-4 border-b border-gray-700 text-white">Like 1</div>
        </div>
      </section>

    </main>

    <!-- Lignes verticales desktop -->
    <div class="hidden fixed left-16 top-0 w-px h-screen bg-gray-700 z-40 md:block lg:left-64"></div>
    <div class="hidden fixed right-64 top-0 w-px h-screen bg-gray-700 z-40 md:block lg:right-80"></div>


    @include('partials/sectionFolowSearch')
  

  
<script>
  lucide.createIcons();
</script>
<script>
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', (e) => {
    e.preventDefault();

    // Style des onglets
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.remove('active', 'border-blue-500', 'text-white', 'font-semibold');
      t.classList.add('text-gray-400');
    });
    
    tab.classList.add('active', 'border-blue-500', 'text-white', 'font-semibold');
    tab.classList.remove('text-gray-400');

    // Affichage contenu
    const target = tab.dataset.target;
    
    // Cacher TOUT
    document.getElementById('container-posts').classList.add('hidden');
    document.getElementById('container-replies').classList.add('hidden');
    document.getElementById('container-medias').classList.add('hidden');
    document.getElementById('container-likes').classList.add('hidden');
    
    // Montrer la cible
    document.getElementById(`container-${target}`).classList.remove('hidden');
  });
});
</script>

</body>
</html>
