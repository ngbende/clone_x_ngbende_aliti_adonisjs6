              <button type="submit"
                      class="px-4 py-2 rounded-full text-sm font-semibold 
                             {{ isBlocked ? 'bg-green-600' : 'bg-red-600' }} hover:opacity-90 transition">
                {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
              </button>
            </form>
          </div>
        @endif
      </div>

      <!-- Onglets profil -->
      <section id="post_profil" class="flex w-full border-b border-gray-700 mt-6">
        <nav id="nav_post" class="flex w-full text-sm overflow-x-auto">
          <a href="#" class="tab flex-1 text-center py-3 font-semibold border-b-2 border-blue-500 active whitespace-nowrap px-4" data-target="posts">Posts</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="replies">Réponses</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="medias">Tweets-marquants</a>
          <a href="#" class="tab flex-1 text-center py-3 text-gray-400 hover:text-white whitespace-nowrap px-4" data-target="likes">J'aime</a>
        </nav>
      </section>

      <!-- Contenu des onglets -->
      <section id="profile-tweets" class="flex w-full flex-col">
        <div id="container-posts" class="w-full flex-col">
          @each(tweet in tweets)
            <div class="flex gap-3 px-4">
              @include('partials/tweetSecProfile')
              @!component('components/reponseForm')
              @!component('components/deleteTweet')
            </div>
          @endeach
        </div>

        <div id="container-replies" class="hidden">
          @each(tweet in userReplies)
            <div class="flex gap-3 px-4">
              @include('partials/tweetSecProfile')
              @!component('components/reponseForm')
              @!component('components/deleteTweet')
            </div>
          @endeach
        </div>

        <div id="container-medias" class="hidden">
          @each(tweet in userMedias)
            <div class="flex gap-3 px-4">
              @include('partials/tweetSecProfile')
              @!component('components/reponseForm')
              @!component('components/deleteTweet')
            </div>
          @endeach
        </div>

        <div id="container-likes" class="hidden">
          @each(tweet in userLikes)
            <div class="flex gap-3 px-4">
              @include('partials/tweetSecProfile')
              @!component('components/reponseForm')
              @!component('components/deleteTweet')
            </div>
          @endeach
        </div>
      </section>

    </main>

    @include('partials/sectionFolowSearch')
  

     <!-- Lignes verticales - uniquement sur desktop MD+ -->
    <div class="hidden md:block fixed left-16 top-0 w-px h-screen bg-gray-700 z-40 lg:left-64"></div>
    <!-- Ligne droite uniquement XL+ quand la sidebar apparaît -->
<script>
  lucide.createIcons();
</script>
<script>
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', (e) => {
    e.preventDefault();

    // Style des onglets
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.remove('active', 'border-blue-500', 'text-white', 'font-semibold');
      t.classList.add('text-gray-400');
    });
    
    tab.classList.add('active', 'border-blue-500', 'text-white', 'font-semibold');
    tab.classList.remove('text-gray-400');

    // Affichage contenu
    const target = tab.dataset.target;
    
    // Cacher TOUT
    document.getElementById('container-posts').classList.add('hidden');
    document.getElementById('container-replies').classList.add('hidden');
    document.getElementById('container-medias').classList.add('hidden');
    document.getElementById('container-likes').classList.add('hidden');
    
    // Montrer la cible
    document.getElementById(`container-${target}`).classList.remove('hidden');
  });
});
</script>

</body>
</html>
