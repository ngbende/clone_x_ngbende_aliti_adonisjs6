<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Document
    </title>
    <script src="https://cdn.tailwindcss.com">

    </script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  </head>
  <body class="bg-black w-full flex flex-col h-screen">
    @include('partials/header')

<main id="main_profil" class="relative ml-[20%] w-2/4 h-full flex flex-col border-l border-r border-gray-700">

  <!-- Header sticky -->
  <div class="sticky top-0 z-50 bg-black/70 backdrop-blur-md text-white flex items-center gap-4 p-3 border-b border-gray-700">
    <a href="/accueil">
      <img width="20" height="20" src="https://img.icons8.com/sf-regular-filled/48/FFFFFF/left.png"/>
    </a>

    <div class="flex flex-col">
      <p class="font-semibold text-white text-sm username1">username</p>
      <p class="text-gray-400 text-xs">0 messages</p>
    </div>

    <div class="ml-auto">
      <img width="17" height="17" src="https://img.icons8.com/ios/50/FFFFFF/search--v1.png"/>
    </div>
  </div>

  <!-- Bannière + avatar -->
  <section id="photo_profil" class="relative w-full h-52 bg-gray-700">
    <img class="object-cover w-full h-full" id="banner-img"/>

    <img class="absolute -bottom-14 left-4 w-32 h-32 rounded-full border-4 border-black object-cover"
         id="profile-img" />

    <button class="absolute bottom-3 right-4 text-white border border-gray-500 rounded-full px-4 py-1 text-sm">
      Modifier le profil
    </button>
  </section>

  <!-- Infos utilisateur -->
  <div id="para-name-user_profil" class="mt-16 px-5 text-white">
    <p class="font-semibold username1">username</p>
    <p class="text-gray-400 text-sm username2">@username</p>

    <div class="flex gap-2 items-center mt-2 text-gray-400 text-sm">
      <img width="15" height="15"
        src="https://img.icons8.com/ios-glyphs/30/FFFFFF/calendar.png"/>
      <span>Inscrit en juillet 2025</span>
    </div>

    <div class="flex gap-4 mt-2 text-sm">
      <p><span class="font-semibold">0</span> abonnements</p>
      <p><span class="font-semibold">0</span> abonnés</p>
    </div>
  </div>

  <!-- Onglets profil -->
  <section id="post_profil" class="flex w-full border-b border-gray-700 mt-5">
    <nav id="nav_post" class="flex w-full justify-between text-sm">
     <a href="#" class="tab w-full text-center py-3 font-semibold border-b-2 border-blue-500 active" data-target="posts">Posts</a>
<a href="#" class="tab w-full text-center py-3 text-gray-400 hover:text-white" data-target="replies">Réponses</a>
<a href="#" class="tab w-full text-center py-3 text-gray-400 hover:text-white" data-target="medias">Tweets-marquants</a>
<a href="#" class="tab w-full text-center py-3 text-gray-400 hover:text-white" data-target="likes">J'aime</a>

    </nav>
  </section>

  <section id="profile-tweets" class="flex flex-col">
     <div id="container-posts">
     @each(tweet in tweets)
          @include('partials/tweetSection')
         @!component('components/reponseForm')
         @!component('components/deleteTweet')

          {{--  @!component('components/reponseForm')  --}}
        @endeach
      </div>
        <div id="container-replies" class="hidden flex flex-col">
    <!-- Contenu chargé via fetch -->
  </div>

  <div id="container-medias" class="hidden flex flex-col">
    <!-- Filtrage médias ici si nécessaire -->
  </div>

  <div id="container-likes" class="hidden flex flex-col">
    <!-- Filtrage likes ici si nécessaire -->
  </div>
  </section>

</main>


@include('partials/sectionFolowSearch')
<script>
  lucide.createIcons();
</script>
<script>
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', async (e) => {
    e.preventDefault()

    // Onglet actif
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.remove('active', 'border-blue-500', 'text-white', 'font-semibold')
      t.classList.add('text-gray-400')
    })
    tab.classList.add('active', 'border-blue-500', 'text-white', 'font-semibold')
    tab.classList.remove('text-gray-400')

    const target = tab.dataset.target

    // Cacher tous les containers
    document.querySelectorAll('#profile-tweets > div').forEach(c => c.classList.add('hidden'))

    if(target === 'replies') {
      const repliesContainer = document.getElementById('container-replies')
      repliesContainer.classList.remove('hidden')
       

      // Si pas déjà chargé, fetch les réponses
      if(!repliesContainer.innerHTML.trim()) {
        const res = await fetch(`/profile/tweets/{{ user.id }}/reply`)
        const html = await res.text()
        repliesContainer.innerHTML = html
      }
    } else {
      const container = document.getElementById(`container-${target}`)
      container.classList.remove('hidden')
    }
  })
})
</script>
</body>
</html>
