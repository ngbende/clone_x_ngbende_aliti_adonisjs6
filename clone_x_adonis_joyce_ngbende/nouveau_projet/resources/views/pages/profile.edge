  <body class="bg-black w-full flex flex-col h-screen">
    @include('partials/header')

    <main id="main_profil" class="relative ml-[20%] w-2/4 h-full flex flex-col">
      <div
        class="sticky z-50 h-15 justify-between top-0 bg-opacity-80 backdrop-blur-md text-white flex gap-10 p-4 border-b border-gray-700"
      >
        <a href="acceuil.html">          <img
            width="20"
            height="20"
            src="https://img.icons8.com/sf-regular-filled/48/FFFFFF/left.png"
            alt="left"
          /></a>

        <a href="" class="mr-40">
          <div id="para-name-user_profil1" class="flex flex-col">
