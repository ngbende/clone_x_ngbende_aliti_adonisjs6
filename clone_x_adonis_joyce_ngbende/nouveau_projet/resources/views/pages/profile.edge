      </div>
      <section id="photo_profil" class="flex flex-col bg-gray-700 h-52 w-full mt-33">
        <div class="bg-[#333639] w-auto h-full relative flex items-start">
          <div id="space_couverture" class="w-[100%]">
          </div>

          <div
            class="div-profil rounded-full border-black border-5 w-35 h-35 bg-[#333639] absolute top-32 left-4"
            aria-label="Placeholder photo de profil"
          >
            <img class="profile-picture object-cover w-full h-full rounded-full" />
          </div>
          <!-- <div id="case-profil" class="flex flex-row"> -->
          <button
            id="btn-modifier"
            class="text-white sm:ml-[-200px] mt-55 border-white border-[1px] rounded-full text-sm p-3 w-[200px] cursor-pointer"
          >
            Modifier le profil
            </button>
          <!--  Popup (modal) -->
          <div
            id="popup-modifier"
            class="hidden fixed inset-0 bg-opacity-50 h-screen overflow-y-scroll  flex  justify-center items-center z-50"
          >
            <div class="space_popup bg-white p-6 rounded shadow-lg w-[45%] h-screen mt-10 text-center mr-28">
              <!-- <h2 class="text-lg font-semibold mb-4">Modifier votre photo</h2> -->

              <!-- Champ pour choisir une image -->
              <!-- zone couverture -->
              <img
                width="40"
                height="40"
                src="https://img.icons8.com/ios-filled/50/apple-camera.png"
                alt="apple-camera"
                id="icon-couverture"
                class=" mt-40 ml-60 cursor-pointer"
              />
              <img id="preview_couverture" class="w-full h-32 object-cover  " />

              <input type="file" accept="image/*" id="input-couverture" style="display: none" />

              <div
                id="space_photo"
                class="rounded-full border-black border-5 w-20 h-20 bg-[#333639] mt-4"
                aria-label="Placeholder photo de profil"
              >
                <img id="preview_profil" class="rounded-full w-full h-full object-cover hidden" />

                <img
                  width="50"
                  height="50"
                  src="https://img.icons8.com/ios-filled/50/apple-camera.png"
                  alt="apple-camera"
                  id="icon-profil"
                  class=" flex  absolute mt-2 ml-2 cursor-pointer"
                />
                <input type="file" id="input-profil" accept="image/*" style="display: none" />
              </div>

              <!-- Boutons -->
              <div class="flex justify-around mt-32">
                <button id="btn-annuler" class="bg-gray-400 text-white px-4 py-2 rounded">Annuler</button>
                <button id="btn-valider" class="bg-green-600 text-white px-4 py-2 rounded">Enregistrer</button>
              </div>
            </div>
          </div>

        </div>
      </div>
