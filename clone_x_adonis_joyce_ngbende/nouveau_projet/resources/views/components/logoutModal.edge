<div
  id="logoutModal"
  class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden  z-50"
>
  <div class="bg-white rounded-lg p-6 w-96">
    <h2 class="text-lg font-semibold mb-4">
      Confirmer la déconnexion
    </h2>
    <p id="modalMessage" class="mb-4">
    </p>
    <div class="flex justify-end gap-4">
      <button onclick="closeLogoutModal()" class="px-4 py-2 bg-gray-300 rounded">Annuler</button>
      <form id="logoutForm" method="POST">
        {{ csrfField() }}
        {{--  <input type="hidden" name="_method" value="DELETE" />  --}}
        <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded">se deconnecter</button>
      </form>
    </div>
  </div>
</div>
<script>
  function openLogoutModal() {
    document.getElementById("modalMessage").innerText = `Voulez-vous vraiment vous deconnecter" ?`;
    const form = document.getElementById("logoutForm");
    form.action = `/logout`; // route deconection
    document.getElementById("logoutModal").classList.remove("hidden");
  }

  function closeLogoutModal() {
    document.getElementById("logoutModal").classList.add("hidden");
  }
</script>

